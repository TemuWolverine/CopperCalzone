<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CopperCalzone.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="AppMonoFontFamily">Consolas, Menlo, Monaco, 'Courier New', monospace</FontFamily>

      <!-- Scaled Typography Tokens (Base = 16 at 100%) -->
      <x:Double x:Key="FontSizeMicro">11</x:Double>
      <x:Double x:Key="FontSizeXS">13</x:Double>
      <x:Double x:Key="FontSizeSM">14</x:Double>
      <x:Double x:Key="FontSizeMD">16</x:Double>
      <x:Double x:Key="FontSizeLG">18</x:Double>
      <x:Double x:Key="FontSizeXL">24</x:Double>
      <x:Double x:Key="FontSizeXXL">32</x:Double>
      <x:Double x:Key="FontSizeCode">34</x:Double>

      <ResourceDictionary.ThemeDictionaries>
        <!-- Google Material 3 Expressive Dark Palette (Forest Green & Copper) -->
        <ResourceDictionary x:Key="Dark">
          <!-- M3 Surface Hierarchy -->
          <SolidColorBrush x:Key="M3SurfaceBrush" Color="#111412" />
          <SolidColorBrush x:Key="M3SurfaceContainerLowBrush" Color="#181B19" />
          <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#1D211E" />
          <SolidColorBrush x:Key="M3SurfaceContainerHighBrush" Color="#272B28" />
          <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#323633" />
          <SolidColorBrush x:Key="M3SurfaceOverlayBrush" Color="#EB272B28" />

          <!-- M3 Expressive Primary (#194C2B), Secondary (#CC916B) & Tertiary Roles -->
          <SolidColorBrush x:Key="M3PrimaryBrush" Color="#8FD8A5" />
          <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#0A391B" />
          <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#194C2B" />
          <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#B8F2C8" />

          <SolidColorBrush x:Key="M3SecondaryBrush" Color="#CC916B" />
          <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="#5C3B27" />
          <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="#FCE1CF" />

          <SolidColorBrush x:Key="M3TertiaryBrush" Color="#E2C28B" />
          <SolidColorBrush x:Key="M3TertiaryContainerBrush" Color="#52421E" />
          <SolidColorBrush x:Key="M3OnTertiaryContainerBrush" Color="#FFE8BA" />

          <!-- M3 Content & Outline Roles -->
          <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#E3E6E3" />
          <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#C4C9C4" />
          <SolidColorBrush x:Key="M3OutlineBrush" Color="#8E948F" />
          <SolidColorBrush x:Key="M3OutlineVariantBrush" Color="#444A45" />
          <SolidColorBrush x:Key="M3ErrorBrush" Color="#F2B8B5" />

          <!-- Mapped App Brushes for Compatibility -->
          <SolidColorBrush x:Key="AppPrimaryBgBrush" Color="#111412" />
          <SolidColorBrush x:Key="AppSecondaryBgBrush" Color="#181B19" />
          <SolidColorBrush x:Key="AppTertiaryBgBrush" Color="#272B28" />
          <SolidColorBrush x:Key="AppOverlayBgBrush" Color="#F01D211E" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#444A45" />
          <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#E3E6E3" />
          <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#C4C9C4" />
          <SolidColorBrush x:Key="AppMutedTextBrush" Color="#8E948F" />
          <SolidColorBrush x:Key="AppHoverBgBrush" Color="#323633" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#8FD8A5" />
          <SolidColorBrush x:Key="AppAccentDimBrush" Color="#194C2B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <themes:MaterialTheme BaseTheme="Dark" PrimaryColor="Green" SecondaryColor="Amber" />
    <materialIcons:MaterialIconStyles />

    <StyleInclude Source="avares://CopperCalzone/Styles/Typography.axaml" />
    <StyleInclude Source="avares://CopperCalzone/Styles/Containers.axaml" />
    <StyleInclude Source="avares://CopperCalzone/Styles/Buttons.axaml" />
  </Application.Styles>
</Application>
