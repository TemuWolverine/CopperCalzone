<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CopperCalzone.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="AppMonoFontFamily">Consolas, Menlo, Monaco, 'Courier New', monospace</FontFamily>

      <ResourceDictionary.ThemeDictionaries>
        <!-- Google Material 3 Expressive Dark Palette -->
        <ResourceDictionary x:Key="Dark">
          <!-- M3 Surface Hierarchy -->
          <SolidColorBrush x:Key="M3SurfaceBrush" Color="#141218" />
          <SolidColorBrush x:Key="M3SurfaceContainerLowBrush" Color="#1D1B20" />
          <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#211F26" />
          <SolidColorBrush x:Key="M3SurfaceContainerHighBrush" Color="#2B2930" />
          <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#36343B" />
          <SolidColorBrush x:Key="M3SurfaceOverlayBrush" Color="#EB2B2930" />

          <!-- M3 Expressive Primary, Secondary & Tertiary Roles -->
          <SolidColorBrush x:Key="M3PrimaryBrush" Color="#D0BCFF" />
          <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#381E72" />
          <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#4F378B" />
          <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#EADDFF" />

          <SolidColorBrush x:Key="M3SecondaryBrush" Color="#CCC2DC" />
          <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="#4A4458" />
          <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="#E8DEF8" />

          <SolidColorBrush x:Key="M3TertiaryBrush" Color="#EFB8C8" />
          <SolidColorBrush x:Key="M3TertiaryContainerBrush" Color="#633B48" />
          <SolidColorBrush x:Key="M3OnTertiaryContainerBrush" Color="#FFD8E4" />

          <!-- M3 Content & Outline Roles -->
          <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#E6E0E9" />
          <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#CAC4D0" />
          <SolidColorBrush x:Key="M3OutlineBrush" Color="#938F99" />
          <SolidColorBrush x:Key="M3OutlineVariantBrush" Color="#49454F" />
          <SolidColorBrush x:Key="M3ErrorBrush" Color="#F2B8B5" />

          <!-- Mapped App Brushes for Compatibility -->
          <SolidColorBrush x:Key="AppPrimaryBgBrush" Color="#141218" />
          <SolidColorBrush x:Key="AppSecondaryBgBrush" Color="#1D1B20" />
          <SolidColorBrush x:Key="AppTertiaryBgBrush" Color="#2B2930" />
          <SolidColorBrush x:Key="AppOverlayBgBrush" Color="#F0211F26" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#49454F" />
          <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#E6E0E9" />
          <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#CAC4D0" />
          <SolidColorBrush x:Key="AppMutedTextBrush" Color="#938F99" />
          <SolidColorBrush x:Key="AppHoverBgBrush" Color="#36343B" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#D0BCFF" />
          <SolidColorBrush x:Key="AppAccentDimBrush" Color="#4F378B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <themes:MaterialTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Pink" />
    <materialIcons:MaterialIconStyles />

    <StyleInclude Source="avares://CopperCalzone/Styles/Typography.axaml" />
    <StyleInclude Source="avares://CopperCalzone/Styles/Containers.axaml" />
    <StyleInclude Source="avares://CopperCalzone/Styles/Buttons.axaml" />
  </Application.Styles>
</Application>
