<UserControl
          x:Class="CopperCalzone.Views.SettingsView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:vm="using:CopperCalzone.ViewModels"
          d:DesignHeight="800"
          d:DesignWidth="1000"
          x:DataType="vm:SettingsViewModel"
          Background="{DynamicResource M3SurfaceBrush}"
          mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
                  MaxWidth="920"
                  Margin="20,12,20,32"
                  HorizontalAlignment="Center"
                  Spacing="16">

            <!--  Header Card  -->
            <Border
                      Padding="24,18"
                      Background="{DynamicResource M3SurfaceContainerLowBrush}"
                      Classes="m3-surface-sheet"
                      CornerRadius="24">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Spacing="4">
                        <StackPanel
                                  VerticalAlignment="Center"
                                  Orientation="Horizontal"
                                  Spacing="10">
                            <materialIcons:MaterialIcon
                                      Width="26"
                                      Height="26"
                                      Foreground="{DynamicResource M3PrimaryBrush}"
                                      Kind="TuneVariant" />
                            <TextBlock
                                      VerticalAlignment="Center"
                                      FontSize="{DynamicResource FontSizeXL}"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource M3OnSurfaceBrush}"
                                      Text="Settings &amp; Preferences" />
                        </StackPanel>
                        <TextBlock
                                  Classes="m3-caption"
                                  FontSize="{DynamicResource FontSizeMD}"
                                  Text="Configure default views, persistent layer selections, and startup behavior" />
                        <TextBlock
                                  Margin="0,4,0,0"
                                  Classes="m3-mono-small"
                                  Foreground="{DynamicResource M3PrimaryBrush}"
                                  Text="{Binding StatusMessage}" />
                    </StackPanel>

                    <!--  Action Buttons  -->
                    <StackPanel
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Orientation="Horizontal"
                              Spacing="10">
                        <Button
                                  Padding="12,8"
                                  Classes="tool-btn"
                                  Command="{Binding ResetAllDefaultsCommand}"
                                  ToolTip.Tip="Reset all preferences to factory defaults">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource M3ErrorBrush}"
                                          Kind="Restore" />
                                <TextBlock
                                          FontSize="{DynamicResource FontSizeSM}"
                                          Foreground="{DynamicResource M3ErrorBrush}"
                                          Text="Reset Defaults" />
                            </StackPanel>
                        </Button>

                        <Button
                                  Padding="14,8"
                                  Classes="m3-tonal"
                                  Command="{Binding CloseSettingsCommand}"
                                  CornerRadius="16"
                                  ToolTip.Tip="Return to PCB Viewer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="16"
                                          Height="16"
                                          Kind="ArrowLeft" />
                                <TextBlock
                                          FontSize="{DynamicResource FontSizeSM}"
                                          FontWeight="SemiBold"
                                          Text="Done" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  1. Navigation & Startup Preferences Card  -->
            <Border Classes="m3-card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon
                                  Width="18"
                                  Height="18"
                                  Foreground="{DynamicResource M3PrimaryBrush}"
                                  Kind="CompassOutline" />
                        <TextBlock Classes="m3-section-title" Text="NAVIGATION &amp; STARTUP DEFAULTS" />
                    </StackPanel>

                    <!--  Default Sidebar Tab  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Default View on Board Load" />
                            <TextBlock Classes="m3-caption" Text="Select which sidebar tab is automatically opened when a PCB is loaded" />
                        </StackPanel>

                        <Border Grid.Column="1" Classes="m3-pill-bar">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button
                                          Padding="14,6"
                                          Classes="tab-btn"
                                          Classes.active="{Binding IsDefaultTabNets}"
                                          Command="{Binding SetDefaultSidebarTabCommand}"
                                          CommandParameter="nets">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon
                                                  Width="14"
                                                  Height="14"
                                                  Kind="LanConnect" />
                                        <TextBlock FontSize="{DynamicResource FontSizeSM}" Text="Nets" />
                                    </StackPanel>
                                </Button>
                                <Button
                                          Padding="14,6"
                                          Classes="tab-btn"
                                          Classes.active="{Binding IsDefaultTabBom}"
                                          Command="{Binding SetDefaultSidebarTabCommand}"
                                          CommandParameter="bom">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon
                                                  Width="14"
                                                  Height="14"
                                                  Kind="FormatListChecks" />
                                        <TextBlock FontSize="{DynamicResource FontSizeSM}" Text="BOM" />
                                    </StackPanel>
                                </Button>
                                <Button
                                          Padding="14,6"
                                          Classes="tab-btn"
                                          Classes.active="{Binding IsDefaultTabLayers}"
                                          Command="{Binding SetDefaultSidebarTabCommand}"
                                          CommandParameter="layers">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon
                                                  Width="14"
                                                  Height="14"
                                                  Kind="LayersOutline" />
                                        <TextBlock FontSize="{DynamicResource FontSizeSM}" Text="Layers" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Sidebar Open by Default  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Keep Side Panel Open by Default" />
                            <TextBlock Classes="m3-caption" Text="Automatically open the left side drawer on desktop startup" />
                        </StackPanel>
                        <CheckBox
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsSidebarOpenByDefault}" />
                    </Grid>

                    <!--  Remember Custom Sidebar Widths  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Remember Custom Side Panel Widths" />
                            <TextBlock Classes="m3-caption" Text="Persist dragged side panel widths across app restarts (e.g. wider BOM vs compact Nets)" />
                        </StackPanel>
                        <CheckBox
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding RememberSidebarWidths}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  2. Layer Selection & Rendering Defaults Card  -->
            <Border Classes="m3-card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon
                                  Width="18"
                                  Height="18"
                                  Foreground="{DynamicResource M3PrimaryBrush}"
                                  Kind="LayersTripleOutline" />
                        <TextBlock Classes="m3-section-title" Text="LAYER SELECTION &amp; RENDERING DEFAULTS" />
                    </StackPanel>

                    <!--  Default Layer Preset  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Default Layer Preset" />
                            <TextBlock Classes="m3-caption" Text="Initial layer visibility preset applied when opening a new board" />
                        </StackPanel>

                        <WrapPanel
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Orientation="Horizontal">
                            <Button
                                      Margin="0,0,6,0"
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsPresetAll}"
                                      Command="{Binding SetDefaultLayerPresetCommand}"
                                      CommandParameter="all"
                                      Content="All Layers" />
                            <Button
                                      Margin="0,0,6,0"
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsPresetTop}"
                                      Command="{Binding SetDefaultLayerPresetCommand}"
                                      CommandParameter="top"
                                      Content="Top View" />
                            <Button
                                      Margin="0,0,6,0"
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsPresetBottom}"
                                      Command="{Binding SetDefaultLayerPresetCommand}"
                                      CommandParameter="bottom"
                                      Content="Bottom View" />
                            <Button
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsPresetCopper}"
                                      Command="{Binding SetDefaultLayerPresetCommand}"
                                      CommandParameter="copper"
                                      Content="Copper Only" />
                        </WrapPanel>
                    </Grid>

                    <!--  Pad & Via Net Name Labels  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Show Net Names on Pads &amp; Vias" />
                            <TextBlock Classes="m3-caption" Text="Display net name labels directly inside pads and via rings by default" />
                        </StackPanel>
                        <CheckBox
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding ShowPadNetNames}" />
                    </Grid>

                    <!--  Copper Pour Fill Mode  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Copper Pour Zones Fill Mode" />
                            <TextBlock Classes="m3-caption" Text="Default rendering style for KiCad copper fill zones" />
                        </StackPanel>

                        <WrapPanel
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Orientation="Horizontal">
                            <Button
                                      Margin="0,0,6,0"
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsZoneSolid}"
                                      Command="{Binding SetZoneModeCommand}"
                                      CommandParameter="solid"
                                      Content="Solid Fill" />
                            <Button
                                      Margin="0,0,6,0"
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsZoneOutline}"
                                      Command="{Binding SetZoneModeCommand}"
                                      CommandParameter="outline"
                                      Content="Outlines Only" />
                            <Button
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsZoneHide}"
                                      Command="{Binding SetZoneModeCommand}"
                                      CommandParameter="hide"
                                      Content="Hidden" />
                        </WrapPanel>
                    </Grid>

                    <!--  Layer Visibility Defaults  -->
                    <Border
                              Margin="0,6,0,0"
                              Padding="14,10"
                              Background="{DynamicResource M3SurfaceContainerHighBrush}"
                              CornerRadius="16">
                        <StackPanel Spacing="10">
                            <TextBlock
                                      Classes="m3-label-medium"
                                      FontWeight="Bold"
                                      Text="Default Layer Visibility Toggles" />
                            <TextBlock Classes="m3-caption" Text="Checked layers are enabled by default for all boards" />

                            <TextBlock
                                      Margin="0,4,0,2"
                                      Classes="m3-mono-small"
                                      FontWeight="Bold"
                                      Text="COPPER LAYERS" />
                            <ItemsControl ItemsSource="{Binding DefaultCopperLayers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerDefaultItemViewModel">
                                        <CheckBox Margin="0,0,16,6" IsChecked="{Binding IsVisible}">
                                            <StackPanel
                                                      VerticalAlignment="Center"
                                                      Orientation="Horizontal"
                                                      Spacing="6">
                                                <Border
                                                          Width="12"
                                                          Height="12"
                                                          Background="{Binding ColorBrush}"
                                                          CornerRadius="3" />
                                                <TextBlock
                                                          VerticalAlignment="Center"
                                                          Classes="m3-label-small"
                                                          Text="{Binding Name}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                      Margin="0,6,0,2"
                                      Classes="m3-mono-small"
                                      FontWeight="Bold"
                                      Text="TECHNICAL LAYERS" />
                            <ItemsControl ItemsSource="{Binding DefaultTechnicalLayers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerDefaultItemViewModel">
                                        <CheckBox Margin="0,0,16,6" IsChecked="{Binding IsVisible}">
                                            <StackPanel
                                                      VerticalAlignment="Center"
                                                      Orientation="Horizontal"
                                                      Spacing="6">
                                                <Border
                                                          Width="12"
                                                          Height="12"
                                                          Background="{Binding ColorBrush}"
                                                          CornerRadius="3" />
                                                <TextBlock
                                                          VerticalAlignment="Center"
                                                          Classes="m3-label-small"
                                                          Text="{Binding Name}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  3. BOM & Assembly Preferences Card  -->
            <Border Classes="m3-card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon
                                  Width="18"
                                  Height="18"
                                  Foreground="{DynamicResource M3PrimaryBrush}"
                                  Kind="FormatListChecks" />
                        <TextBlock Classes="m3-section-title" Text="INTERACTIVE BOM &amp; ASSEMBLY TRACKING" />
                    </StackPanel>

                    <!--  Default Sort Column  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Default BOM Sort Column &amp; Order" />
                            <TextBlock Classes="m3-caption" Text="Initial column used to group and sort component items" />
                        </StackPanel>

                        <StackPanel
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Orientation="Horizontal"
                                  Spacing="8">
                            <ComboBox
                                      Width="140"
                                      SelectedIndex="0"
                                      SelectedItem="{Binding DefaultBomSortColumn}">
                                <!--  Dropdown for sort columns  -->
                                <ComboBoxItem Content="references" />
                                <ComboBoxItem Content="value" />
                                <ComboBoxItem Content="footprint" />
                                <ComboBoxItem Content="quantity" />
                                <ComboBoxItem Content="placed" />
                            </ComboBox>

                            <CheckBox
                                      VerticalAlignment="Center"
                                      Content="Ascending"
                                      IsChecked="{Binding DefaultBomSortAscending}" />
                        </StackPanel>
                    </Grid>

                    <!--  Default Component Filter  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Default Component Filter" />
                            <TextBlock Classes="m3-caption" Text="Which filter chip is selected by default on the BOM tab" />
                        </StackPanel>

                        <WrapPanel
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Orientation="Horizontal">
                            <Button
                                      Margin="0,0,6,0"
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsFilterAll}"
                                      Command="{Binding SetDefaultBomFilterCommand}"
                                      CommandParameter="all"
                                      Content="All Parts" />
                            <Button
                                      Margin="0,0,6,0"
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsFilterTop}"
                                      Command="{Binding SetDefaultBomFilterCommand}"
                                      CommandParameter="top"
                                      Content="Top (F.Cu)" />
                            <Button
                                      Margin="0,0,6,0"
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsFilterBottom}"
                                      Command="{Binding SetDefaultBomFilterCommand}"
                                      CommandParameter="bottom"
                                      Content="Bottom (B.Cu)" />
                            <Button
                                      Classes="chip-btn"
                                      Classes.active="{Binding IsFilterUnplaced}"
                                      Command="{Binding SetDefaultBomFilterCommand}"
                                      CommandParameter="unplaced"
                                      Content="Unplaced" />
                        </WrapPanel>
                    </Grid>

                    <!--  Reset BOM Column Widths  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="BOM Column Widths" />
                            <TextBlock Classes="m3-caption" Text="Reset table column widths back to defaults (Placed: 50, Ref: 110, Val: 100, Package: 140, Qty: 50)" />
                        </StackPanel>

                        <Button
                                  Grid.Column="1"
                                  Padding="12,6"
                                  VerticalAlignment="Center"
                                  Classes="tool-btn"
                                  Command="{Binding ResetBomColumnWidthsCommand}"
                                  CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="TableColumnWidth" />
                                <TextBlock
                                          FontSize="{DynamicResource FontSizeSM}"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Text="Reset Column Widths" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  4. Appearance & Storage Card  -->
            <Border Classes="m3-card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon
                                  Width="18"
                                  Height="18"
                                  Foreground="{DynamicResource M3PrimaryBrush}"
                                  Kind="PaletteOutline" />
                        <TextBlock Classes="m3-section-title" Text="APPEARANCE &amp; CONFIGURATION STORAGE" />
                    </StackPanel>

                    <!--  Interface Font Scale (80% - 150%)  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Interface Font Scale" />
                            <TextBlock Classes="m3-caption" Text="Scale all interface font sizes from 80% to 150% (default: 100%)" />
                        </StackPanel>

                        <StackPanel
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Orientation="Horizontal"
                                  Spacing="12">
                            <TextBlock
                                      VerticalAlignment="Center"
                                      Classes="m3-caption"
                                      Text="80%" />
                            <Slider
                                      Width="180"
                                      VerticalAlignment="Center"
                                      IsSnapToTickEnabled="True"
                                      Maximum="150"
                                      Minimum="80"
                                      TickFrequency="5"
                                      Value="{Binding FontScalePercent, Mode=TwoWay}" />
                            <TextBlock
                                      VerticalAlignment="Center"
                                      Classes="m3-caption"
                                      Text="150%" />
                            <Border
                                      MinWidth="54"
                                      Padding="10,4"
                                      VerticalAlignment="Center"
                                      Background="{DynamicResource M3SecondaryContainerBrush}"
                                      CornerRadius="12">
                                <TextBlock
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Classes="m3-mono-label"
                                          Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                          Text="{Binding FontScalePercent, StringFormat='{}{0:0}%'}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!--  Immersive Mode (Android Nav Bar / Desktop Fullscreen)  -->
                    <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock Classes="m3-label-large" Text="Immersive Mode (Hide System Bars)" />
                            <TextBlock Classes="m3-caption" Text="Auto-hides the system navigation bar for maximum screen area (slide up from bottom to reveal)" />
                        </StackPanel>

                        <CheckBox
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="Immersive"
                                  IsChecked="{Binding IsImmersiveMode}" />
                    </Grid>

                    <!--  Settings File Path  -->
                    <Grid
                              Margin="0,6,0,0"
                              ColumnDefinitions="*,Auto"
                              IsVisible="{Binding ShowConfigFileLocation}">
                        <StackPanel
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <TextBlock
                                      Classes="m3-label-medium"
                                      FontWeight="Bold"
                                      Text="Configuration File Location" />
                            <TextBlock
                                      Classes="m3-mono-small"
                                      Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                      Text="{Binding SettingsFilePath}"
                                      TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                                  Grid.Column="1"
                                  Padding="12,6"
                                  VerticalAlignment="Center"
                                  Classes="tool-btn"
                                  Command="{Binding OpenSettingsFolderCommand}"
                                  CornerRadius="12"
                                  ToolTip.Tip="Open configuration folder in file explorer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="FolderOpenOutline" />
                                <TextBlock
                                          FontSize="{DynamicResource FontSizeSM}"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Text="Open Folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
