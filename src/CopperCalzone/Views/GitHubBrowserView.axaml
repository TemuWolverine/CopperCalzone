<UserControl
          x:Class="CopperCalzone.Views.GitHubBrowserView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:models="using:CopperCalzone.Models"
          xmlns:octo="clr-namespace:Octokit;assembly=Octokit"
          xmlns:vm="using:CopperCalzone.ViewModels"
          d:DesignHeight="700"
          d:DesignWidth="1024"
          x:DataType="vm:GitHubBrowserViewModel"
          mc:Ignorable="d">

    <!--  M3 Expressive Full Screen GitHub PCB Browser  -->
    <Border
              Margin="8,0,8,8"
              Background="{DynamicResource M3SurfaceBrush}"
              Classes="m3-surface-sheet">
        <Grid Background="{DynamicResource M3SurfaceContainerLowBrush}" RowDefinitions="Auto,*,Auto">

            <!--  Top Header / M3 App Bar  -->
            <Border
                      Grid.Row="0"
                      Padding="22,14"
                      Background="{DynamicResource M3SurfaceContainerBrush}"
                      BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                      BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!--  Icon & Title  -->
                    <StackPanel
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Orientation="Horizontal"
                              Spacing="12">
                        <Border
                                  Width="40"
                                  Height="40"
                                  Background="{DynamicResource M3PrimaryContainerBrush}"
                                  CornerRadius="14">
                            <materialIcons:MaterialIcon
                                      Width="22"
                                      Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                      Kind="Github" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Classes="m3-title-medium" Text="GitHub PCB Browser" />
                            <TextBlock Classes="m3-caption" Text="Browse repositories &amp; load KiCad PCB layouts directly" />
                        </StackPanel>
                    </StackPanel>

                    <!--  User Status Chip & Sign Out (if logged in)  -->
                    <StackPanel
                              Grid.Column="2"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !!CurrentUserName}"
                              Orientation="Horizontal"
                              Spacing="10">
                        <Border
                                  Padding="12,6"
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="18">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="CheckDecagram" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                          Text="{Binding CurrentUserName}" />
                            </StackPanel>
                        </Border>
                        <Button
                                  Padding="12,7"
                                  Classes="tool-btn"
                                  Command="{Binding LogoutCommand}"
                                  ToolTip.Tip="Sign Out from GitHub">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Kind="Logout" />
                                <TextBlock VerticalAlignment="Center" Text="Sign Out" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  Return to PCB Viewport Button  -->
                    <Button
                              Grid.Column="3"
                              Classes="m3-tonal"
                              Command="{Binding CloseCommand}"
                              ToolTip.Tip="Return to PCB Viewport">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon
                                      Width="16"
                                      Height="16"
                                      Kind="ArrowLeft" />
                            <TextBlock VerticalAlignment="Center" Text="Back to Viewer" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!--  Main Body Area  -->
            <Grid Grid.Row="1" Margin="24">

                <!--  STEP 1: Not Authenticated (M3 Expressive Hero Card)  -->
                <Border
                          MaxWidth="480"
                          Padding="40,36"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="{DynamicResource M3SurfaceContainerHighBrush}"
                          BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                          BorderThickness="1"
                          BoxShadow="0 12 36 0 #40000000"
                          CornerRadius="28"
                          IsVisible="{Binding IsNotAuthenticated}">
                    <StackPanel HorizontalAlignment="Center" Spacing="18">
                        <Border
                                  Width="72"
                                  Height="72"
                                  HorizontalAlignment="Center"
                                  Background="{DynamicResource M3PrimaryContainerBrush}"
                                  CornerRadius="24">
                            <materialIcons:MaterialIcon
                                      Width="40"
                                      Height="40"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                      Kind="Github" />
                        </Border>

                        <TextBlock
                                  HorizontalAlignment="Center"
                                  Classes="m3-headline-medium"
                                  Text="Connect to GitHub" />

                        <TextBlock
                                  Classes="m3-body-medium"
                                  Text="Sign in to browse your personal repositories, organization projects, and collaborator boards for KiCad PCB layouts."
                                  TextAlignment="Center"
                                  TextWrapping="Wrap" />

                        <Button
                                  Margin="0,6,0,0"
                                  Padding="24,12"
                                  HorizontalAlignment="Center"
                                  Classes="m3-filled"
                                  Command="{Binding StartLoginCommand}"
                                  CornerRadius="24">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <materialIcons:MaterialIcon
                                          Width="18"
                                          Height="18"
                                          Kind="Github" />
                                <TextBlock VerticalAlignment="Center" Text="Sign in with GitHub" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--  STEP 2: Device Code Pending (M3 Expressive Hero Card)  -->
                <Border
                          MaxWidth="500"
                          Padding="40,36"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="{DynamicResource M3SurfaceContainerHighBrush}"
                          BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                          BorderThickness="1"
                          BoxShadow="0 12 36 0 #40000000"
                          CornerRadius="28"
                          IsVisible="{Binding IsDeviceCodePending}">
                    <StackPanel HorizontalAlignment="Center" Spacing="18">
                        <Border
                                  Width="56"
                                  Height="56"
                                  HorizontalAlignment="Center"
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="20">
                            <materialIcons:MaterialIcon
                                      Width="28"
                                      Height="28"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                      Kind="KeyVariant" />
                        </Border>

                        <TextBlock
                                  HorizontalAlignment="Center"
                                  Classes="m3-headline-medium"
                                  Text="Authorize Device" />

                        <TextBlock
                                  Classes="m3-body-medium"
                                  Text="Enter the following one-time verification code on GitHub to complete authorization:"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap" />

                        <!--  M3 Primary Container Highlighted Code Box  -->
                        <Border
                                  Padding="28,16"
                                  HorizontalAlignment="Center"
                                  Background="{DynamicResource M3PrimaryContainerBrush}"
                                  CornerRadius="20">
                            <TextBlock
                                      Classes="m3-mono-code"
                                      Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                      Text="{Binding UserCode}" />
                        </Border>

                        <StackPanel
                                  Margin="0,6,0,0"
                                  HorizontalAlignment="Center"
                                  Orientation="Horizontal"
                                  Spacing="12">
                            <Button
                                      Padding="20,11"
                                      Classes="m3-filled"
                                      Command="{Binding CopyCodeAndOpenBrowserCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon
                                              Width="16"
                                              Height="16"
                                              Kind="ContentCopy" />
                                    <TextBlock VerticalAlignment="Center" Text="Copy Code &amp; Open GitHub" />
                                </StackPanel>
                            </Button>
                            <Button
                                      Padding="16,11"
                                      Classes="m3-tonal"
                                      Command="{Binding CancelLoginCommand}">
                                <TextBlock VerticalAlignment="Center" Text="Cancel" />
                            </Button>
                        </StackPanel>

                        <TextBlock
                                  HorizontalAlignment="Center"
                                  Classes="m3-body-small"
                                  FontStyle="Italic"
                                  Text="Waiting for authorization in your browser..." />
                    </StackPanel>
                </Border>

                <!--  STEP 3: Repositories List  -->
                <Grid
                          ColumnDefinitions="*"
                          IsVisible="{Binding IsRepoList}"
                          RowDefinitions="Auto,*">

                    <!--  M3 SearchBar & Refresh  -->
                    <Grid
                              Grid.Row="0"
                              Margin="0,0,0,16"
                              ColumnDefinitions="*,Auto">
                        <Border
                                  Grid.Column="0"
                                  Padding="16,6"
                                  Classes="m3-search-bar">
                            <Grid ColumnDefinitions="Auto,*">
                                <materialIcons:MaterialIcon
                                          Grid.Column="0"
                                          Width="20"
                                          Height="20"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                          Kind="Magnify" />
                                <TextBox
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="{DynamicResource FontSizeMD}"
                                          Text="{Binding RepoSearchQuery, Mode=TwoWay}"
                                          Watermark="Search repositories by name, owner, or description..." />
                            </Grid>
                        </Border>

                        <Button
                                  Grid.Column="1"
                                  Margin="12,0,0,0"
                                  Padding="16,10"
                                  Classes="m3-tonal"
                                  Command="{Binding RefreshRepositoriesCommand}"
                                  ToolTip.Tip="Refresh repository list">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="17"
                                          Height="17"
                                          Kind="Refresh" />
                                <TextBlock VerticalAlignment="Center" Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Repository ListBox Card  -->
                    <Border
                              Grid.Row="1"
                              Background="{DynamicResource M3SurfaceContainerBrush}"
                              Classes="m3-surface-sheet">
                        <ListBox
                                  Padding="8"
                                  Background="Transparent"
                                  ItemsSource="{Binding FilteredRepositories}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="octo:Repository">
                                    <Button
                                              Padding="14,12"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Command="{Binding $parent[UserControl].((vm:GitHubBrowserViewModel)DataContext).SelectRepositoryCommand}"
                                              CommandParameter="{Binding}"
                                              CornerRadius="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!--  Repo M3 Tonal Icon Container  -->
                                            <Border
                                                      Grid.Column="0"
                                                      Width="40"
                                                      Height="40"
                                                      Margin="0,0,14,0"
                                                      VerticalAlignment="Center"
                                                      Background="{DynamicResource M3SecondaryContainerBrush}"
                                                      CornerRadius="14">
                                                <materialIcons:MaterialIcon
                                                          Width="20"
                                                          Height="20"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                          Kind="SourceRepository" />
                                            </Border>

                                            <!--  Info  -->
                                            <StackPanel
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                              VerticalAlignment="Center"
                                                              Classes="m3-title-small"
                                                              Text="{Binding FullName}" />
                                                    <Border Classes="m3-badge-tertiary" IsVisible="{Binding Private}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon
                                                                      Width="11"
                                                                      Height="11"
                                                                      Foreground="{DynamicResource M3OnTertiaryContainerBrush}"
                                                                      Kind="LockOutline" />
                                                            <TextBlock
                                                                      Classes="m3-label-small"
                                                                      Foreground="{DynamicResource M3OnTertiaryContainerBrush}"
                                                                      Text="Private" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                          Classes="m3-body-small"
                                                          IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                          Text="{Binding Description}"
                                                          TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!--  Chevron  -->
                                            <materialIcons:MaterialIcon
                                                      Grid.Column="2"
                                                      Width="20"
                                                      Height="20"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                      Kind="ChevronRight" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!--  STEP 4: Folder & PCB File Navigation  -->
                <Grid
                          ColumnDefinitions="*"
                          IsVisible="{Binding IsFileNavigation}"
                          RowDefinitions="Auto,Auto,*">

                    <!--  Repository Header & Previous Navigation Button  -->
                    <Grid
                              Grid.Row="0"
                              Margin="0,0,0,12"
                              ColumnDefinitions="Auto,*,Auto">
                        <Button
                                  Grid.Column="0"
                                  Padding="14,8"
                                  Classes="m3-tonal"
                                  Command="{Binding NavigatePreviousCommand}"
                                  ToolTip.Tip="Navigate to previous location">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="16"
                                          Height="16"
                                          Kind="ArrowLeft" />
                                <TextBlock VerticalAlignment="Center" Text="Previous" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                                  Grid.Column="1"
                                  Margin="16,0"
                                  VerticalAlignment="Center"
                                  Classes="m3-title-medium"
                                  Text="{Binding SelectedRepository.FullName}" />

                        <Border
                                  Grid.Column="2"
                                  Padding="12,6"
                                  VerticalAlignment="Center"
                                  Classes="m3-badge-secondary"
                                  CornerRadius="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                          Kind="SourceBranch" />
                                <TextBlock
                                          Classes="m3-label-medium"
                                          Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                          Text="{Binding SelectedRepository.DefaultBranch}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  M3 Pill Breadcrumbs Navigation  -->
                    <Border
                              Grid.Row="1"
                              Margin="0,0,0,12"
                              Padding="12,6"
                              Background="{DynamicResource M3SurfaceContainerHighBrush}"
                              BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                              BorderThickness="1"
                              CornerRadius="18">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BreadcrumbItem">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button
                                                      Padding="8,4"
                                                      Classes="tool-btn"
                                                      Command="{Binding $parent[UserControl].((vm:GitHubBrowserViewModel)DataContext).NavigateBreadcrumbCommand}"
                                                      CommandParameter="{Binding Path}"
                                                      CornerRadius="12">
                                                <TextBlock Text="{Binding Name}" />
                                            </Button>
                                            <materialIcons:MaterialIcon
                                                      Width="15"
                                                      Height="15"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                      Kind="ChevronRight" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!--  Folder Items List Card  -->
                    <Border
                              Grid.Row="2"
                              Background="{DynamicResource M3SurfaceContainerBrush}"
                              Classes="m3-surface-sheet">
                        <Grid>
                            <ListBox
                                      Padding="8"
                                      Background="Transparent"
                                      ItemsSource="{Binding CurrentFolderItems}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GitHubItemModel">
                                        <Button
                                                  Padding="14,10"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Command="{Binding $parent[UserControl].((vm:GitHubBrowserViewModel)DataContext).NavigateFolderCommand}"
                                                  CommandParameter="{Binding}"
                                                  CornerRadius="16">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!--  Icon: Folder or PCB  -->
                                                <Panel
                                                          Grid.Column="0"
                                                          Width="38"
                                                          Height="38"
                                                          Margin="0,0,14,0"
                                                          VerticalAlignment="Center">
                                                    <Border
                                                              Background="{DynamicResource M3SecondaryContainerBrush}"
                                                              CornerRadius="12"
                                                              IsVisible="{Binding IsDirectory}">
                                                        <materialIcons:MaterialIcon
                                                                  Width="20"
                                                                  Height="20"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                  Kind="FolderOutline" />
                                                    </Border>
                                                    <Border
                                                              Background="{DynamicResource M3PrimaryContainerBrush}"
                                                              CornerRadius="12"
                                                              IsVisible="{Binding !IsDirectory}">
                                                        <materialIcons:MaterialIcon
                                                                  Width="20"
                                                                  Height="20"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                                                  Kind="DeveloperBoard" />
                                                    </Border>
                                                </Panel>

                                                <!--  Name & Size  -->
                                                <StackPanel
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Spacing="3">
                                                    <TextBlock Classes="m3-label-large" Text="{Binding Name}" />
                                                    <TextBlock Classes="m3-caption" Text="{Binding FormattedSize}" />
                                                </StackPanel>

                                                <!--  Cached + M3 Primary Container Action Pill  -->
                                                <StackPanel
                                                          Grid.Column="2"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{Binding !IsDirectory}"
                                                          Orientation="Horizontal"
                                                          Spacing="8">
                                                    <Border Classes="m3-badge-secondary" IsVisible="{Binding IsCached}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon
                                                                      Width="14"
                                                                      Height="14"
                                                                      Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                      Kind="CheckCircleOutline" />
                                                            <TextBlock
                                                                      Classes="m3-label-small"
                                                                      Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                                      Text="Cached" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="m3-badge-primary">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon
                                                                      Width="15"
                                                                      Height="15"
                                                                      Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                                                      Kind="OpenInApp" />
                                                            <TextBlock
                                                                      Classes="m3-label-medium"
                                                                      FontWeight="Bold"
                                                                      Foreground="{DynamicResource M3OnPrimaryContainerBrush}"
                                                                      Text="Load PCB" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--  Empty State  -->
                            <StackPanel
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding !CurrentFolderItems.Count}"
                                      Spacing="12">
                                <materialIcons:MaterialIcon
                                          Width="40"
                                          Height="40"
                                          HorizontalAlignment="Center"
                                          Foreground="{DynamicResource M3OutlineBrush}"
                                          Kind="FolderOpenOutline" />
                                <TextBlock
                                          HorizontalAlignment="Center"
                                          Classes="m3-body-medium"
                                          Text="No .kicad_pcb files or subfolders found in this directory." />
                                <Button
                                          HorizontalAlignment="Center"
                                          Classes="m3-tonal"
                                          Command="{Binding NavigateUpCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon
                                                  Width="16"
                                                  Height="16"
                                                  Kind="ArrowUp" />
                                        <TextBlock VerticalAlignment="Center" Text="Go Up One Level" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!--  Footer Status Bar  -->
            <Border
                      Grid.Row="2"
                      Padding="22,10"
                      Background="{DynamicResource M3SurfaceContainerBrush}"
                      BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                      BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Orientation="Horizontal"
                              Spacing="10">
                        <!--  Loading indicator text  -->
                        <TextBlock
                                  VerticalAlignment="Center"
                                  Classes="m3-body-small"
                                  IsVisible="{Binding IsLoading}"
                                  Text="{Binding StatusMessage}" />
                        <!--  Error message  -->
                        <TextBlock
                                  VerticalAlignment="Center"
                                  Classes="m3-body-small"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource M3ErrorBrush}"
                                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                  Text="{Binding ErrorMessage}" />
                    </StackPanel>

                    <Button
                              Grid.Column="1"
                              Padding="14,6"
                              Classes="tool-btn"
                              Command="{Binding CloseCommand}">
                        <TextBlock Text="Return to Viewer" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
