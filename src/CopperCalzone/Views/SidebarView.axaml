<UserControl
          x:Class="CopperCalzone.Views.SidebarView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:views="using:CopperCalzone.Views"
          xmlns:vm="using:CopperCalzone.ViewModels"
          d:DesignHeight="720"
          d:DesignWidth="520"
          x:DataType="vm:MainViewModel"
          mc:Ignorable="d">

    <Border
              Width="{Binding SidebarWidth}"
              Margin="8,0,4,8"
              Background="{DynamicResource M3SurfaceContainerLowBrush}"
              BoxShadow="0 6 20 0 #26000000"
              Classes="m3-surface-sheet"
              IsVisible="{Binding IsLeftSidebarOpen}">
        <Grid RowDefinitions="Auto,*">

            <!--  M3 Expressive Segmented Pill Tabs Header (Nets / BOM / Layers)  -->
            <Grid
                      Grid.Row="0"
                      Margin="12,12,12,6"
                      ColumnDefinitions="*,Auto">
                <Border
                          Grid.Column="0"
                          Padding="4"
                          Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                          CornerRadius="16">
                    <Grid ColumnDefinitions="*,*,*">
                        <Button
                                  Grid.Column="0"
                                  Padding="10,8"
                                  Classes="tab-btn"
                                  Classes.active="{Binding IsNetsTabActive}"
                                  Command="{Binding SwitchTabCommand}"
                                  CommandParameter="nets">
                            <StackPanel
                                      HorizontalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="4">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Kind="LanConnect" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          Text="Nets (" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          Text="{Binding Nets.TotalNetCount}" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          Text=")" />
                            </StackPanel>
                        </Button>

                        <Button
                                  Grid.Column="1"
                                  Padding="10,8"
                                  Classes="tab-btn"
                                  Classes.active="{Binding IsBomTabActive}"
                                  Command="{Binding SwitchTabCommand}"
                                  CommandParameter="bom">
                            <StackPanel
                                      HorizontalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="4">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Kind="FormatListChecks" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          Text="BOM (" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          Text="{Binding Bom.TotalBomCount}" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          Text=")" />
                            </StackPanel>
                        </Button>

                        <Button
                                  Grid.Column="2"
                                  Padding="10,8"
                                  Classes="tab-btn"
                                  Classes.active="{Binding IsLayersTabActive}"
                                  Command="{Binding SwitchTabCommand}"
                                  CommandParameter="layers">
                            <StackPanel
                                      HorizontalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="4">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Kind="LayersOutline" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          Text="Layers" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Button
                          Grid.Column="1"
                          Width="36"
                          Height="36"
                          Margin="8,0,0,0"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Classes="tool-btn"
                          Command="{Binding ToggleLeftSidebarCommand}"
                          CornerRadius="18"
                          ToolTip.Tip="Close Side Sheet">
                    <materialIcons:MaterialIcon
                              Width="18"
                              Height="18"
                              Kind="Close" />
                </Button>
            </Grid>

            <!--  TAB 1: NETS  -->
            <Grid
                      Grid.Row="1"
                      IsVisible="{Binding IsNetsTabActive}"
                      RowDefinitions="Auto,Auto,*">

                <!--  M3 Expressive Pill SearchBar  -->
                <Border
                          Grid.Row="0"
                          Margin="12,6,12,8"
                          Classes="m3-search-bar">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                                  Grid.Column="0"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                  Kind="Magnify" />
                        <TextBox
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="{DynamicResource FontSizeMD}"
                                  Text="{Binding SearchQuery}"
                                  Watermark="Search nets (GND, +3V3, SPI)..." />
                        <Button
                                  Grid.Column="2"
                                  Width="28"
                                  Height="28"
                                  Margin="4,0,0,0"
                                  Padding="0"
                                  Classes="tool-btn"
                                  Command="{Binding ClearSearchCommand}"
                                  CornerRadius="14"
                                  IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                  ToolTip.Tip="Clear search">
                            <materialIcons:MaterialIcon
                                      Width="16"
                                      Height="16"
                                      Kind="CloseCircle" />
                        </Button>
                    </Grid>
                </Border>

                <!--  Net Count & Clear Action Bar  -->
                <Border
                          Grid.Row="1"
                          Padding="16,6"
                          BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                          BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Classes="m3-caption"
                                  FontWeight="Medium"
                                  Text="{Binding ShowingNetsLabel}" />
                        <Button
                                  Grid.Column="1"
                                  Padding="10,4"
                                  Classes="tool-btn"
                                  Command="{Binding ClearSelectionCommand}"
                                  CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon
                                          Width="13"
                                          Height="13"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="FilterRemoveOutline" />
                                <TextBlock
                                          FontSize="{DynamicResource FontSizeSM}"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Text="Clear" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  Virtualized M3 Net List  -->
                <ListBox
                          Grid.Row="2"
                          Padding="8,6"
                          Background="Transparent"
                          ItemsSource="{Binding FilteredNets}"
                          SelectedItem="{Binding SelectedNetItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetItemViewModel">
                            <Grid Margin="4,4" ColumnDefinitions="Auto,*,Auto">
                                <!--  Expressive Power / Signal Color Indicator  -->
                                <Ellipse
                                          Grid.Column="0"
                                          Width="10"
                                          Height="10"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          Fill="{Binding DotBrush}" />

                                <!--  Net Name  -->
                                <TextBlock
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Classes="m3-mono m3-label-large"
                                          Text="{Binding DisplayName}"
                                          TextTrimming="CharacterEllipsis"
                                          ToolTip.Tip="{Binding Name}" />

                                <!--  M3 Tonal Pin & Via Badges  -->
                                <StackPanel
                                          Grid.Column="2"
                                          Margin="6,0,0,0"
                                          Orientation="Horizontal"
                                          Spacing="4">
                                    <Border
                                              Padding="8,3"
                                              Classes="m3-badge-secondary"
                                              CornerRadius="12">
                                        <TextBlock
                                                  Classes="m3-label-small"
                                                  Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                  Text="{Binding PadCountBadge}" />
                                    </Border>
                                    <Border
                                              Padding="8,3"
                                              Classes="m3-badge-tertiary"
                                              CornerRadius="12"
                                              IsVisible="{Binding HasVias}">
                                        <TextBlock
                                                  Classes="m3-label-small"
                                                  Foreground="{DynamicResource M3OnTertiaryContainerBrush}"
                                                  Text="{Binding ViaCountBadge}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!--  TAB 2: INTERACTIVE BOM (M3 Expressive Assembly Tracker & Component Table)  -->
            <Grid
                      Grid.Row="1"
                      IsVisible="{Binding IsBomTabActive}"
                      RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

                <!--  1. M3 Expressive Assembly Progress Card  -->
                <Border
                          Grid.Row="0"
                          Margin="12,6,12,8"
                          Padding="14,10"
                          Background="{DynamicResource M3SurfaceContainerBrush}"
                          BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                          BorderThickness="1"
                          CornerRadius="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel
                                      Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="CheckDecagramOutline" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          FontSize="{DynamicResource FontSizeSM}"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource M3OnSurfaceBrush}"
                                          Text="{Binding AssemblyProgressText}" />
                            </StackPanel>

                            <Button
                                      Grid.Column="1"
                                      Padding="8,3"
                                      Classes="tool-btn"
                                      Command="{Binding MarkAllBomPlacedCommand}"
                                      CornerRadius="10"
                                      ToolTip.Tip="Mark all BOM items as placed">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon
                                              Width="13"
                                              Height="13"
                                              Foreground="{DynamicResource M3PrimaryBrush}"
                                              Kind="CheckAll" />
                                    <TextBlock
                                              FontSize="{DynamicResource FontSizeXS}"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource M3PrimaryBrush}"
                                              Text="All" />
                                </StackPanel>
                            </Button>

                            <Button
                                      Grid.Column="2"
                                      Margin="4,0,0,0"
                                      Padding="8,3"
                                      Classes="tool-btn"
                                      Command="{Binding ResetBomPlacedCommand}"
                                      CornerRadius="10"
                                      ToolTip.Tip="Reset placed status for all components">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <materialIcons:MaterialIcon
                                              Width="13"
                                              Height="13"
                                              Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                              Kind="Restart" />
                                    <TextBlock
                                              FontSize="{DynamicResource FontSizeXS}"
                                              Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                              Text="Reset" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ProgressBar
                                  Height="6"
                                  Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                                  CornerRadius="3"
                                  Foreground="{DynamicResource M3PrimaryBrush}"
                                  Maximum="1"
                                  Minimum="0"
                                  Value="{Binding AssemblyProgressRatio}" />
                    </StackPanel>
                </Border>

                <!--  2. M3 Pill SearchBar for BOM  -->
                <Border
                          Grid.Row="1"
                          Margin="12,0,12,8"
                          Classes="m3-search-bar">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                                  Grid.Column="0"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                  Kind="Magnify" />
                        <TextBox
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="{DynamicResource FontSizeMD}"
                                  Text="{Binding BomSearchQuery}"
                                  Watermark="Search ref, value, or footprint (R1, 100nF, 0402)..." />
                        <Button
                                  Grid.Column="2"
                                  Width="28"
                                  Height="28"
                                  Margin="4,0,0,0"
                                  Padding="0"
                                  Classes="tool-btn"
                                  Command="{Binding ClearBomSearchCommand}"
                                  CornerRadius="14"
                                  IsVisible="{Binding BomSearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                  ToolTip.Tip="Clear BOM search">
                            <materialIcons:MaterialIcon
                                      Width="16"
                                      Height="16"
                                      Kind="CloseCircle" />
                        </Button>
                    </Grid>
                </Border>

                <!--  3. M3 Filter Chips for BOM  -->
                <ScrollViewer
                          Grid.Row="2"
                          Margin="12,0,12,8"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                                  Classes="chip-btn"
                                  Classes.active="{Binding IsBomFilterAll}"
                                  Command="{Binding SetBomFilterCommand}"
                                  CommandParameter="all">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon
                                          Width="13"
                                          Height="13"
                                          IsVisible="{Binding IsBomFilterAll}"
                                          Kind="Check" />
                                <TextBlock Text="All Parts" />
                            </StackPanel>
                        </Button>
                        <Button
                                  Classes="chip-btn"
                                  Classes.active="{Binding IsBomFilterTop}"
                                  Command="{Binding SetBomFilterCommand}"
                                  CommandParameter="top">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon
                                          Width="13"
                                          Height="13"
                                          Kind="ArrowUpBoldBoxOutline" />
                                <TextBlock Text="Top (F.Cu)" />
                            </StackPanel>
                        </Button>
                        <Button
                                  Classes="chip-btn"
                                  Classes.active="{Binding IsBomFilterBottom}"
                                  Command="{Binding SetBomFilterCommand}"
                                  CommandParameter="bottom">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon
                                          Width="13"
                                          Height="13"
                                          Kind="ArrowDownBoldBoxOutline" />
                                <TextBlock Text="Bottom (B.Cu)" />
                            </StackPanel>
                        </Button>
                        <Button
                                  Classes="chip-btn"
                                  Classes.active="{Binding IsBomFilterUnplaced}"
                                  Command="{Binding SetBomFilterCommand}"
                                  CommandParameter="unplaced">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon
                                          Width="13"
                                          Height="13"
                                          Kind="CheckboxBlankOutline" />
                                <TextBlock Text="Unplaced" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!--  4. BOM Showing Count & Clear Selection Bar  -->
                <Border
                          Grid.Row="3"
                          Padding="16,4"
                          BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                          BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                                  Grid.Column="0"
                                  VerticalAlignment="Center"
                                  Classes="m3-caption"
                                  FontWeight="Medium"
                                  Text="{Binding ShowingBomLabel}" />
                        <Button
                                  Grid.Column="1"
                                  Padding="10,4"
                                  Classes="tool-btn"
                                  Command="{Binding ClearBomSelectionCommand}"
                                  CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon
                                          Width="13"
                                          Height="13"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="FilterRemoveOutline" />
                                <TextBlock
                                          FontSize="{DynamicResource FontSizeSM}"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Text="Clear" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  5 & 6. Sortable BOM Table (Headers & Virtualized Rows with Adjustable Column Widths)  -->
                <ScrollViewer
                          Grid.Row="4"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                    <Grid RowDefinitions="Auto,*">
                        <!--  5. Sortable BOM Column Headers with Resize Handles  -->
                        <Border
                                  Grid.Row="0"
                                  Padding="4,4"
                                  Background="{DynamicResource M3SurfaceContainerBrush}"
                                  BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                  BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                                <!--  Column 0: Placed  -->
                                <Grid Grid.Column="0" Width="{Binding BomColPlacedWidth}">
                                    <Button
                                              Padding="4,4,10,4"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Center"
                                              Classes="tool-btn"
                                              Command="{Binding SortBomByCommand}"
                                              CommandParameter="placed"
                                              ToolTip.Tip="Sort by Placed Status">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <materialIcons:MaterialIcon
                                                      Width="12"
                                                      Height="12"
                                                      Kind="CheckboxMarkedOutline" />
                                            <TextBlock Classes="m3-label-small" Text="Placed" />
                                        </StackPanel>
                                    </Button>
                                    <Thumb
                                              HorizontalAlignment="Right"
                                              Classes="col-resizer"
                                              DoubleTapped="OnColResizerDoubleTapped"
                                              DragDelta="OnColResizerDragDelta"
                                              Tag="placed"
                                              ToolTip.Tip="Drag to resize column (Double-click to reset)" />
                                </Grid>

                                <!--  Column 1: References  -->
                                <Grid Grid.Column="1" Width="{Binding BomColRefWidth}">
                                    <Button
                                              Padding="6,4,10,4"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Classes="tool-btn"
                                              Command="{Binding SortBomByCommand}"
                                              CommandParameter="references"
                                              ToolTip.Tip="Sort by Reference Designators (C1, C5, etc.)">
                                        <TextBlock Classes="m3-label-small" Text="References" />
                                    </Button>
                                    <Thumb
                                              HorizontalAlignment="Right"
                                              Classes="col-resizer"
                                              DoubleTapped="OnColResizerDoubleTapped"
                                              DragDelta="OnColResizerDragDelta"
                                              Tag="references"
                                              ToolTip.Tip="Drag to resize column (Double-click to reset)" />
                                </Grid>

                                <!--  Column 2: Value  -->
                                <Grid Grid.Column="2" Width="{Binding BomColValWidth}">
                                    <Button
                                              Padding="6,4,10,4"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Classes="tool-btn"
                                              Command="{Binding SortBomByCommand}"
                                              CommandParameter="value"
                                              ToolTip.Tip="Sort by Component Value">
                                        <TextBlock Classes="m3-label-small" Text="Value" />
                                    </Button>
                                    <Thumb
                                              HorizontalAlignment="Right"
                                              Classes="col-resizer"
                                              DoubleTapped="OnColResizerDoubleTapped"
                                              DragDelta="OnColResizerDragDelta"
                                              Tag="value"
                                              ToolTip.Tip="Drag to resize column (Double-click to reset)" />
                                </Grid>

                                <!--  Column 3: Footprint  -->
                                <Grid Grid.Column="3" Width="{Binding BomColFpWidth}">
                                    <Button
                                              Padding="6,4,10,4"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Classes="tool-btn"
                                              Command="{Binding SortBomByCommand}"
                                              CommandParameter="footprint"
                                              ToolTip.Tip="Sort by Footprint Package">
                                        <TextBlock Classes="m3-label-small" Text="Footprint" />
                                    </Button>
                                    <Thumb
                                              HorizontalAlignment="Right"
                                              Classes="col-resizer"
                                              DoubleTapped="OnColResizerDoubleTapped"
                                              DragDelta="OnColResizerDragDelta"
                                              Tag="footprint"
                                              ToolTip.Tip="Drag to resize column (Double-click to reset)" />
                                </Grid>

                                <!--  Column 4: Quantity  -->
                                <Grid Grid.Column="4" Width="{Binding BomColQtyWidth}">
                                    <Button
                                              Padding="4,4,10,4"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Center"
                                              Classes="tool-btn"
                                              Command="{Binding SortBomByCommand}"
                                              CommandParameter="quantity"
                                              ToolTip.Tip="Sort by Quantity">
                                        <TextBlock Classes="m3-label-small" Text="Quantity" />
                                    </Button>
                                    <Thumb
                                              HorizontalAlignment="Right"
                                              Classes="col-resizer"
                                              DoubleTapped="OnColResizerDoubleTapped"
                                              DragDelta="OnColResizerDragDelta"
                                              Tag="quantity"
                                              ToolTip.Tip="Drag to resize column (Double-click to reset)" />
                                </Grid>

                                <!--  Column 5: Filler  -->
                                <Border Grid.Column="5" />
                            </Grid>
                        </Border>

                        <!--  6. Virtualized BOM Rows ListBox  -->
                        <ListBox
                                  Grid.Row="1"
                                  Padding="4,2"
                                  Background="Transparent"
                                  ItemsSource="{Binding FilteredBomItems}"
                                  SelectedItem="{Binding SelectedBomItem}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0,2" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BomItemViewModel">
                                    <Grid
                                              Margin="0,1"
                                              VerticalAlignment="Center"
                                              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                                        <!--  Placed Checkbox  -->
                                        <Border
                                                  Grid.Column="0"
                                                  Width="{Binding $parent[views:SidebarView].((vm:MainViewModel)DataContext).BomColPlacedWidth}"
                                                  HorizontalAlignment="Left">
                                            <CheckBox
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsPlaced}"
                                                      ToolTip.Tip="Mark component group as placed" />
                                        </Border>

                                        <!--  References (Grouped e.g. C1, C5)  -->
                                        <Border
                                                  Grid.Column="1"
                                                  Width="{Binding $parent[views:SidebarView].((vm:MainViewModel)DataContext).BomColRefWidth}"
                                                  Padding="6,0,8,0"
                                                  HorizontalAlignment="Left">
                                            <TextBlock
                                                      VerticalAlignment="Center"
                                                      Classes="m3-mono-label"
                                                      Foreground="{DynamicResource M3PrimaryBrush}"
                                                      Text="{Binding ReferencesText}"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTip.Tip="{Binding ReferencesText}" />
                                        </Border>

                                        <!--  Value + Side Badge  -->
                                        <Border
                                                  Grid.Column="2"
                                                  Width="{Binding $parent[views:SidebarView].((vm:MainViewModel)DataContext).BomColValWidth}"
                                                  Padding="6,0,8,0"
                                                  HorizontalAlignment="Left">
                                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                          Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          Classes="m3-label-medium"
                                                          Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                          Text="{Binding Value}"
                                                          TextTrimming="CharacterEllipsis"
                                                          ToolTip.Tip="{Binding Value}" />
                                                <Border
                                                          Grid.Column="1"
                                                          Margin="3,0,0,0"
                                                          Padding="4,1"
                                                          VerticalAlignment="Center"
                                                          BorderBrush="{Binding SideBrush}"
                                                          BorderThickness="1"
                                                          CornerRadius="6">
                                                    <TextBlock
                                                              FontSize="{DynamicResource FontSizeMicro}"
                                                              FontWeight="Bold"
                                                              Foreground="{Binding SideBrush}"
                                                              Text="{Binding SideText}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!--  Footprint Package  -->
                                        <Border
                                                  Grid.Column="3"
                                                  Width="{Binding $parent[views:SidebarView].((vm:MainViewModel)DataContext).BomColFpWidth}"
                                                  Padding="6,0,8,0"
                                                  HorizontalAlignment="Left">
                                            <TextBlock
                                                      VerticalAlignment="Center"
                                                      Classes="m3-mono-small"
                                                      Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                      Text="{Binding Package}"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTip.Tip="{Binding Package}" />
                                        </Border>

                                        <!--  Quantity Pill Badge  -->
                                        <Border
                                                  Grid.Column="4"
                                                  Width="{Binding $parent[views:SidebarView].((vm:MainViewModel)DataContext).BomColQtyWidth}"
                                                  HorizontalAlignment="Left">
                                            <Border
                                                      Padding="6,2"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Classes="m3-badge-secondary">
                                                <TextBlock
                                                          Classes="m3-label-small"
                                                          Foreground="{DynamicResource M3OnSecondaryContainerBrush}"
                                                          Text="{Binding Quantity}" />
                                            </Border>
                                        </Border>

                                        <!--  Column 5: Filler  -->
                                        <Border Grid.Column="5" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ScrollViewer>

                <!--  7. Selected BOM Item Component Switcher Footer Card  -->
                <Border
                          Grid.Row="5"
                          Padding="14,10"
                          Background="{DynamicResource M3SurfaceContainerHighBrush}"
                          BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                          BorderThickness="0,1,0,0"
                          IsVisible="{Binding SelectedBomItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel
                                      Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="Chip" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-label-medium"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource M3OnSurfaceBrush}"
                                          Text="{Binding SelectedBomItem.Value}"
                                          TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource M3OutlineBrush}"
                                          Text="•" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-mono m3-label-medium"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Text="{Binding SelectedComponentRef}" />
                            </StackPanel>

                            <CheckBox
                                      Grid.Column="1"
                                      Margin="8,0"
                                      VerticalAlignment="Center"
                                      Content="Placed"
                                      IsChecked="{Binding SelectedBomItem.IsPlaced}"
                                      ToolTip.Tip="Mark this component as placed" />

                            <Button
                                      Grid.Column="2"
                                      Padding="10,4"
                                      Classes="m3-tonal"
                                      Command="{Binding PrevBomComponentCommand}"
                                      CornerRadius="12"
                                      ToolTip.Tip="Previous Reference in Group">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Kind="ChevronLeft" />
                            </Button>
                            <Button
                                      Grid.Column="3"
                                      Margin="6,0,0,0"
                                      Padding="10,4"
                                      Classes="m3-filled"
                                      Command="{Binding NextBomComponentCommand}"
                                      CornerRadius="12"
                                      ToolTip.Tip="Next Reference in Group">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Kind="ChevronRight" />
                            </Button>
                        </Grid>

                        <!--  Individual Reference Designator Chips  -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedBomItem.References}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button
                                                  Padding="8,3"
                                                  Classes="chip-btn"
                                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectBomComponentCommand}"
                                                  CommandParameter="{Binding}"
                                                  Content="{Binding}"
                                                  FontSize="{DynamicResource FontSizeXS}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </Grid>

            <!--  TAB 3: LAYERS (M3 Expressive Filled Cards)  -->
            <ScrollViewer
                      Grid.Row="1"
                      Padding="12,8,12,14"
                      IsVisible="{Binding IsLayersTabActive}">
                <StackPanel Spacing="12">

                    <!--  Layer Presets Card  -->
                    <Border Classes="m3-card">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="TuneVariant" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-section-title"
                                          Text="QUICK PRESETS" />
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <Button
                                          Margin="0,0,6,6"
                                          Classes="chip-btn"
                                          Command="{Binding ApplyLayerPresetCommand}"
                                          CommandParameter="all"
                                          Content="All Layers" />
                                <Button
                                          Margin="0,0,6,6"
                                          Classes="chip-btn"
                                          Command="{Binding ApplyLayerPresetCommand}"
                                          CommandParameter="top"
                                          Content="Top View" />
                                <Button
                                          Margin="0,0,6,6"
                                          Classes="chip-btn"
                                          Command="{Binding ApplyLayerPresetCommand}"
                                          CommandParameter="bottom"
                                          Content="Bottom View" />
                                <Button
                                          Margin="0,0,6,6"
                                          Classes="chip-btn"
                                          Command="{Binding ApplyLayerPresetCommand}"
                                          CommandParameter="copper"
                                          Content="Copper Only" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--  Copper Layers Card  -->
                    <Border Classes="m3-card">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="LayersTripleOutline" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-section-title"
                                          Text="COPPER LAYERS" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding CopperLayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerItemViewModel">
                                        <CheckBox Margin="0,3" IsChecked="{Binding IsVisible}">
                                            <StackPanel
                                                      VerticalAlignment="Center"
                                                      Orientation="Horizontal"
                                                      Spacing="8">
                                                <Border
                                                          Width="14"
                                                          Height="14"
                                                          Background="{Binding ColorBrush}"
                                                          CornerRadius="4" />
                                                <TextBlock
                                                          VerticalAlignment="Center"
                                                          Classes="m3-label-large"
                                                          Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Technical Layers Card  -->
                    <Border Classes="m3-card">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="VectorSquare" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-section-title"
                                          Text="TECHNICAL LAYERS" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding TechLayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerItemViewModel">
                                        <CheckBox Margin="0,3" IsChecked="{Binding IsVisible}">
                                            <StackPanel
                                                      VerticalAlignment="Center"
                                                      Orientation="Horizontal"
                                                      Spacing="8">
                                                <Border
                                                          Width="14"
                                                          Height="14"
                                                          Background="{Binding ColorBrush}"
                                                          CornerRadius="4" />
                                                <TextBlock
                                                          VerticalAlignment="Center"
                                                          Classes="m3-label-large"
                                                          Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Pad Net Labels Card  -->
                    <Border Classes="m3-card">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="TagOutline" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-section-title"
                                          Text="PAD &amp; VIA LABELS" />
                            </StackPanel>
                            <CheckBox Content="Show Net Names on Pads &amp; Vias" IsChecked="{Binding ShowPadNetNames}" />
                        </StackPanel>
                    </Border>

                    <!--  Copper Pour Zones Card  -->
                    <Border Classes="m3-card">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon
                                          Width="15"
                                          Height="15"
                                          Foreground="{DynamicResource M3PrimaryBrush}"
                                          Kind="TextureBox" />
                                <TextBlock
                                          VerticalAlignment="Center"
                                          Classes="m3-section-title"
                                          Text="COPPER POUR ZONES" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <RadioButton
                                          Content="Solid Fill"
                                          GroupName="ZoneMode"
                                          IsChecked="{Binding IsZoneSolid}" />
                                <RadioButton
                                          Content="Outlines Only"
                                          GroupName="ZoneMode"
                                          IsChecked="{Binding IsZoneOutline}" />
                                <RadioButton
                                          Content="Hidden"
                                          GroupName="ZoneMode"
                                          IsChecked="{Binding IsZoneHide}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
