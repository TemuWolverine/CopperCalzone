<UserControl
          x:Class="CopperCalzone.Views.NavigationRailView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:m="using:CopperCalzone.Markup"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:vm="using:CopperCalzone.ViewModels"
          d:DesignHeight="800"
          d:DesignWidth="80"
          x:DataType="vm:MainViewModel"
          mc:Ignorable="d">

    <Border
              Width="{Binding NavRailWidth}"
              Background="{DynamicResource M3SurfaceBrush}"
              BorderBrush="{DynamicResource M3OutlineVariantBrush}"
              BorderThickness="0,0,1,0">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition
                          Easing="CubicEaseOut"
                          Property="Width"
                          Duration="0:0:0.2" />
            </Transitions>
        </Border.Transitions>

        <Grid Margin="0,12,0,16" RowDefinitions="Auto,*">

            <!--  1. Rail Toggle Menu Button  -->
            <Grid Grid.Row="0" Margin="12,0,12,12">
                <!--  Collapsed Toggle  -->
                <Button
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          Classes="tool-btn"
                          Command="{Binding ToggleNavRailCommand}"
                          CornerRadius="24"
                          IsVisible="{Binding !IsNavRailExpanded}"
                          ToolTip.Tip="Expand Navigation Rail">
                    <materialIcons:MaterialIcon
                              Width="22"
                              Height="22"
                              Kind="Menu" />
                </Button>

                <!--  Expanded Toggle  -->
                <Button
                          Height="48"
                          Padding="16,0"
                          HorizontalAlignment="Stretch"
                          Classes="tool-btn"
                          Command="{Binding ToggleNavRailCommand}"
                          CornerRadius="24"
                          IsVisible="{Binding IsNavRailExpanded}"
                          ToolTip.Tip="Collapse Navigation Rail">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                                  Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  Kind="MenuOpen" />
                        <TextBlock
                                  Grid.Column="1"
                                  Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  Classes="m3-label-large"
                                  Text="Collapse" />
                        <materialIcons:MaterialIcon
                                  Grid.Column="2"
                                  Width="18"
                                  Height="18"
                                  Kind="ChevronLeft" />
                    </Grid>
                </Button>
            </Grid>

            <!--  2. Destinations Stack (Open PCB, GitHub, PCB Viewer, Schematic, Settings)  -->
            <StackPanel
                      Grid.Row="1"
                      Margin="8,0"
                      Spacing="8">

                <!--  Destination 1: Open PCB  -->
                <!--  Collapsed Item  -->
                <Button
                          Width="64"
                          Height="56"
                          HorizontalAlignment="Center"
                          Classes="nav-rail-item"
                          Command="{Binding RequestOpenFileCommand}"
                          IsVisible="{Binding !IsNavRailExpanded}"
                          ToolTip.Tip="{m:PlatformTip 'Open PCB (.kicad_pcb, .json, .html)',
                                                      '[Ctrl+O]'}">
                    <StackPanel
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="2">
                        <materialIcons:MaterialIcon
                                  Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  Kind="FolderOpenOutline" />
                        <TextBlock
                                  HorizontalAlignment="Center"
                                  Classes="m3-label-small"
                                  Text="Open PCB" />
                    </StackPanel>
                </Button>

                <!--  Expanded Item  -->
                <Button
                          Height="56"
                          HorizontalAlignment="Stretch"
                          Classes="nav-rail-item"
                          Command="{Binding RequestOpenFileCommand}"
                          CornerRadius="28"
                          IsVisible="{Binding IsNavRailExpanded}"
                          ToolTip.Tip="{m:PlatformTip 'Open PCB (.kicad_pcb, .json, .html)',
                                                      '[Ctrl+O]'}">
                    <Grid ColumnDefinitions="Auto,*">
                        <materialIcons:MaterialIcon
                                  Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Kind="FolderOpenOutline" />
                        <TextBlock
                                  Grid.Column="1"
                                  Margin="16,0,16,0"
                                  VerticalAlignment="Center"
                                  Classes="m3-label-large"
                                  Text="Open PCB" />
                    </Grid>
                </Button>


                <!--  Destination 2: GitHub Browser  -->
                <!--  Collapsed Item  -->
                <Button
                          Width="64"
                          Height="56"
                          HorizontalAlignment="Center"
                          Classes="nav-rail-item"
                          Classes.active="{Binding IsGitHubTabActive}"
                          Command="{Binding OpenGitHubBrowserCommand}"
                          IsVisible="{Binding !IsNavRailExpanded}"
                          ToolTip.Tip="GitHub PCB Browser">
                    <Grid>
                        <!--  Active Indicator Pill  -->
                        <Border
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="16"
                                  IsVisible="{Binding IsGitHubTabActive}" />
                        <StackPanel
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <materialIcons:MaterialIcon
                                      Width="20"
                                      Height="20"
                                      HorizontalAlignment="Center"
                                      Kind="Github" />
                            <TextBlock
                                      HorizontalAlignment="Center"
                                      Classes="m3-label-small"
                                      Text="GitHub" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!--  Expanded Item  -->
                <Button
                          Height="56"
                          HorizontalAlignment="Stretch"
                          Classes="nav-rail-item"
                          Classes.active="{Binding IsGitHubTabActive}"
                          Command="{Binding OpenGitHubBrowserCommand}"
                          CornerRadius="28"
                          IsVisible="{Binding IsNavRailExpanded}"
                          ToolTip.Tip="GitHub PCB Browser">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border
                                  Grid.ColumnSpan="2"
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="28"
                                  IsVisible="{Binding IsGitHubTabActive}" />
                        <materialIcons:MaterialIcon
                                  Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Kind="Github" />
                        <TextBlock
                                  Grid.Column="1"
                                  Margin="16,0,16,0"
                                  VerticalAlignment="Center"
                                  Classes="m3-label-large"
                                  Text="GitHub" />
                    </Grid>
                </Button>


                <!--  Destination 3: PCB Viewer  -->
                <!--  Collapsed Item  -->
                <Button
                          Width="64"
                          Height="56"
                          HorizontalAlignment="Center"
                          Classes="nav-rail-item"
                          Classes.active="{Binding IsViewerTabActive}"
                          Command="{Binding SwitchToViewerCommand}"
                          IsVisible="{Binding !IsNavRailExpanded}"
                          ToolTip.Tip="PCB Viewer">
                    <Grid>
                        <!--  Active Indicator Pill  -->
                        <Border
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="16"
                                  IsVisible="{Binding IsViewerTabActive}" />
                        <StackPanel
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <materialIcons:MaterialIcon
                                      Width="20"
                                      Height="20"
                                      HorizontalAlignment="Center"
                                      Kind="DeveloperBoard" />
                            <TextBlock
                                      HorizontalAlignment="Center"
                                      Classes="m3-label-small"
                                      Text="Viewer" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!--  Expanded Item  -->
                <Button
                          Height="56"
                          HorizontalAlignment="Stretch"
                          Classes="nav-rail-item"
                          Classes.active="{Binding IsViewerTabActive}"
                          Command="{Binding SwitchToViewerCommand}"
                          CornerRadius="28"
                          IsVisible="{Binding IsNavRailExpanded}"
                          ToolTip.Tip="PCB Viewer">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border
                                  Grid.ColumnSpan="2"
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="28"
                                  IsVisible="{Binding IsViewerTabActive}" />
                        <materialIcons:MaterialIcon
                                  Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Kind="DeveloperBoard" />
                        <TextBlock
                                  Grid.Column="1"
                                  Margin="16,0,16,0"
                                  VerticalAlignment="Center"
                                  Classes="m3-label-large"
                                  Text="PCB Viewer" />
                    </Grid>
                </Button>


                <!--  Destination 4: Schematic  -->
                <!--  Collapsed Item  -->
                <Button
                          Width="64"
                          Height="56"
                          HorizontalAlignment="Center"
                          Classes="nav-rail-item"
                          Classes.active="{Binding IsSchematicTabActive}"
                          Command="{Binding SwitchToSchematicCommand}"
                          IsVisible="{Binding !IsNavRailExpanded}"
                          ToolTip.Tip="Schematic Viewer">
                    <Grid>
                        <!--  Active Indicator Pill  -->
                        <Border
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="16"
                                  IsVisible="{Binding IsSchematicTabActive}" />
                        <StackPanel
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <materialIcons:MaterialIcon
                                      Width="20"
                                      Height="20"
                                      HorizontalAlignment="Center"
                                      Kind="FileDocumentOutline" />
                            <TextBlock
                                      HorizontalAlignment="Center"
                                      Classes="m3-label-small"
                                      Text="Schematic" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!--  Expanded Item  -->
                <Button
                          Height="56"
                          HorizontalAlignment="Stretch"
                          Classes="nav-rail-item"
                          Classes.active="{Binding IsSchematicTabActive}"
                          Command="{Binding SwitchToSchematicCommand}"
                          CornerRadius="28"
                          IsVisible="{Binding IsNavRailExpanded}"
                          ToolTip.Tip="Schematic Viewer">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border
                                  Grid.ColumnSpan="2"
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="28"
                                  IsVisible="{Binding IsSchematicTabActive}" />
                        <materialIcons:MaterialIcon
                                  Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Kind="FileDocumentOutline" />
                        <TextBlock
                                  Grid.Column="1"
                                  Margin="16,0,16,0"
                                  VerticalAlignment="Center"
                                  Classes="m3-label-large"
                                  Text="Schematic" />
                    </Grid>
                </Button>


                <!--  Destination 4: Settings  -->
                <!--  Collapsed Item  -->
                <Button
                          Width="64"
                          Height="56"
                          HorizontalAlignment="Center"
                          Classes="nav-rail-item"
                          Classes.active="{Binding IsSettingsTabActive}"
                          Command="{Binding OpenSettingsCommand}"
                          IsVisible="{Binding !IsNavRailExpanded}"
                          ToolTip.Tip="Preferences &amp; Settings">
                    <Grid>
                        <!--  Active Indicator Pill  -->
                        <Border
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="16"
                                  IsVisible="{Binding IsSettingsTabActive}" />
                        <StackPanel
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Spacing="2">
                            <materialIcons:MaterialIcon
                                      Width="20"
                                      Height="20"
                                      HorizontalAlignment="Center"
                                      Kind="CogOutline" />
                            <TextBlock
                                      HorizontalAlignment="Center"
                                      Classes="m3-label-small"
                                      Text="Settings" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!--  Expanded Item  -->
                <Button
                          Height="56"
                          HorizontalAlignment="Stretch"
                          Classes="nav-rail-item"
                          Classes.active="{Binding IsSettingsTabActive}"
                          Command="{Binding OpenSettingsCommand}"
                          CornerRadius="28"
                          IsVisible="{Binding IsNavRailExpanded}"
                          ToolTip.Tip="Preferences &amp; Settings">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border
                                  Grid.ColumnSpan="2"
                                  Background="{DynamicResource M3SecondaryContainerBrush}"
                                  CornerRadius="28"
                                  IsVisible="{Binding IsSettingsTabActive}" />
                        <materialIcons:MaterialIcon
                                  Grid.Column="0"
                                  Width="22"
                                  Height="22"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Kind="CogOutline" />
                        <TextBlock
                                  Grid.Column="1"
                                  Margin="16,0,16,0"
                                  VerticalAlignment="Center"
                                  Classes="m3-label-large"
                                  Text="Settings" />
                    </Grid>
                </Button>

            </StackPanel>

        </Grid>
    </Border>
</UserControl>
