<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CopperCalzone.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="80" d:DesignHeight="800"
             x:Class="CopperCalzone.Views.NavigationRailView"
             x:DataType="vm:MainViewModel">

  <Border Background="{DynamicResource M3SurfaceBrush}"
          BorderBrush="{DynamicResource M3OutlineVariantBrush}"
          BorderThickness="0,0,1,0"
          Width="{Binding NavRailWidth}">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Border.Transitions>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,16">

      <!-- 1. Rail Toggle Menu Button -->
      <Grid Grid.Row="0" Margin="12,0,12,12">
        <!-- Collapsed Toggle -->
        <Button Command="{Binding ToggleNavRailCommand}"
                ToolTip.Tip="Expand Navigation Rail"
                Classes="tool-btn"
                Width="48" Height="48"
                CornerRadius="24"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsNavRailExpanded}">
          <materialIcons:MaterialIcon Kind="Menu" Width="22" Height="22" />
        </Button>

        <!-- Expanded Toggle -->
        <Button Command="{Binding ToggleNavRailCommand}"
                ToolTip.Tip="Collapse Navigation Rail"
                Classes="tool-btn"
                Height="48"
                CornerRadius="24"
                HorizontalAlignment="Stretch"
                Padding="16,0"
                IsVisible="{Binding IsNavRailExpanded}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <materialIcons:MaterialIcon Grid.Column="0" Kind="MenuOpen" Width="22" Height="22" />
            <TextBlock Grid.Column="1"
                       Text="Collapse"
                       Classes="m3-label-large"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0" />
            <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronLeft" Width="18" Height="18" />
          </Grid>
        </Button>
      </Grid>

      <!-- 2. Anchored Open PCB FAB -->
      <Grid Grid.Row="1" Margin="12,0,12,20">
        <!-- Collapsed FAB -->
        <Button Command="{Binding RequestOpenFileCommand}"
                ToolTip.Tip="Open PCB (.kicad_pcb, .json, .html) [Ctrl+O]"
                Classes="m3-fab"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsNavRailExpanded}">
          <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="24" Height="24" />
        </Button>

        <!-- Expanded Extended FAB -->
        <Button Command="{Binding RequestOpenFileCommand}"
                ToolTip.Tip="Open PCB (.kicad_pcb, .json, .html) [Ctrl+O]"
                Classes="m3-extended-fab"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding IsNavRailExpanded}">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="22" Height="22" VerticalAlignment="Center" />
            <TextBlock Text="Open PCB" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- 3. Destinations Stack (Viewer, Schematic, GitHub, Settings) -->
      <StackPanel Grid.Row="2" Spacing="8" Margin="8,0">

        <!-- Destination 1: PCB Viewer -->
        <!-- Collapsed Item -->
        <Button Command="{Binding SwitchToViewerCommand}"
                ToolTip.Tip="PCB Viewer"
                Classes="nav-rail-item"
                Classes.active="{Binding IsViewerTabActive}"
                Width="64" Height="56"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsNavRailExpanded}">
          <Grid>
            <!-- Active Indicator Pill -->
            <Border Background="{DynamicResource M3SecondaryContainerBrush}"
                    CornerRadius="16"
                    Width="56" Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                    IsVisible="{Binding IsViewerTabActive}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
              <materialIcons:MaterialIcon Kind="DeveloperBoard" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="Viewer" Classes="m3-label-small" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Button>

        <!-- Expanded Item -->
        <Button Command="{Binding SwitchToViewerCommand}"
                ToolTip.Tip="PCB Viewer"
                Classes="nav-rail-item"
                Classes.active="{Binding IsViewerTabActive}"
                Height="56"
                HorizontalAlignment="Stretch"
                Padding="16,0"
                IsVisible="{Binding IsNavRailExpanded}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.ColumnSpan="2"
                    Background="{DynamicResource M3SecondaryContainerBrush}"
                    CornerRadius="28"
                    IsVisible="{Binding IsViewerTabActive}" />
            <materialIcons:MaterialIcon Grid.Column="0" Kind="DeveloperBoard" Width="22" Height="22" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="PCB Viewer"
                       Classes="m3-label-large"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
          </Grid>
        </Button>


        <!-- Destination 2: Schematic -->
        <!-- Collapsed Item -->
        <Button Command="{Binding SwitchToSchematicCommand}"
                ToolTip.Tip="Schematic Viewer"
                Classes="nav-rail-item"
                Classes.active="{Binding IsSchematicTabActive}"
                Width="64" Height="56"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsNavRailExpanded}">
          <Grid>
            <!-- Active Indicator Pill -->
            <Border Background="{DynamicResource M3SecondaryContainerBrush}"
                    CornerRadius="16"
                    Width="56" Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                    IsVisible="{Binding IsSchematicTabActive}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
              <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="Schematic" Classes="m3-label-small" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Button>

        <!-- Expanded Item -->
        <Button Command="{Binding SwitchToSchematicCommand}"
                ToolTip.Tip="Schematic Viewer"
                Classes="nav-rail-item"
                Classes.active="{Binding IsSchematicTabActive}"
                Height="56"
                HorizontalAlignment="Stretch"
                Padding="16,0"
                IsVisible="{Binding IsNavRailExpanded}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.ColumnSpan="2"
                    Background="{DynamicResource M3SecondaryContainerBrush}"
                    CornerRadius="28"
                    IsVisible="{Binding IsSchematicTabActive}" />
            <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentOutline" Width="22" Height="22" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Schematic"
                       Classes="m3-label-large"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
          </Grid>
        </Button>


        <!-- Destination 3: GitHub Browser -->
        <!-- Collapsed Item -->
        <Button Command="{Binding OpenGitHubBrowserCommand}"
                ToolTip.Tip="GitHub PCB Browser"
                Classes="nav-rail-item"
                Classes.active="{Binding IsGitHubTabActive}"
                Width="64" Height="56"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsNavRailExpanded}">
          <Grid>
            <!-- Active Indicator Pill -->
            <Border Background="{DynamicResource M3SecondaryContainerBrush}"
                    CornerRadius="16"
                    Width="56" Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                    IsVisible="{Binding IsGitHubTabActive}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
              <materialIcons:MaterialIcon Kind="Github" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="GitHub" Classes="m3-label-small" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Button>

        <!-- Expanded Item -->
        <Button Command="{Binding OpenGitHubBrowserCommand}"
                ToolTip.Tip="GitHub PCB Browser"
                Classes="nav-rail-item"
                Classes.active="{Binding IsGitHubTabActive}"
                Height="56"
                HorizontalAlignment="Stretch"
                Padding="16,0"
                IsVisible="{Binding IsNavRailExpanded}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.ColumnSpan="2"
                    Background="{DynamicResource M3SecondaryContainerBrush}"
                    CornerRadius="28"
                    IsVisible="{Binding IsGitHubTabActive}" />
            <materialIcons:MaterialIcon Grid.Column="0" Kind="Github" Width="22" Height="22" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="GitHub"
                       Classes="m3-label-large"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
          </Grid>
        </Button>


        <!-- Destination 4: Settings -->
        <!-- Collapsed Item -->
        <Button Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="Preferences &amp; Settings"
                Classes="nav-rail-item"
                Classes.active="{Binding IsSettingsTabActive}"
                Width="64" Height="56"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsNavRailExpanded}">
          <Grid>
            <!-- Active Indicator Pill -->
            <Border Background="{DynamicResource M3SecondaryContainerBrush}"
                    CornerRadius="16"
                    Width="56" Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                    IsVisible="{Binding IsSettingsTabActive}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
              <materialIcons:MaterialIcon Kind="CogOutline" Width="20" Height="20" HorizontalAlignment="Center" />
              <TextBlock Text="Settings" Classes="m3-label-small" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Button>

        <!-- Expanded Item -->
        <Button Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="Preferences &amp; Settings"
                Classes="nav-rail-item"
                Classes.active="{Binding IsSettingsTabActive}"
                Height="56"
                HorizontalAlignment="Stretch"
                Padding="16,0"
                IsVisible="{Binding IsNavRailExpanded}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.ColumnSpan="2"
                    Background="{DynamicResource M3SecondaryContainerBrush}"
                    CornerRadius="28"
                    IsVisible="{Binding IsSettingsTabActive}" />
            <materialIcons:MaterialIcon Grid.Column="0" Kind="CogOutline" Width="22" Height="22" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Settings"
                       Classes="m3-label-large"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
          </Grid>
        </Button>

      </StackPanel>

      <!-- 4. Bottom Rail Controls: Theme Toggle & Sidebar Sheet Toggle -->
      <StackPanel Grid.Row="3" Spacing="8" Margin="8,0">

        <!-- Theme Toggle -->
        <Button Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="Toggle Dark / Light Theme"
                Classes="tool-btn"
                Width="48" Height="48"
                CornerRadius="24"
                HorizontalAlignment="Center"
                IsVisible="{Binding !IsNavRailExpanded}">
          <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" />
        </Button>

        <Button Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="Toggle Dark / Light Theme"
                Classes="tool-btn"
                Height="48"
                CornerRadius="24"
                HorizontalAlignment="Stretch"
                Padding="16,0"
                IsVisible="{Binding IsNavRailExpanded}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Text="Theme" Classes="m3-label-large" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

      </StackPanel>

    </Grid>
  </Border>
</UserControl>
