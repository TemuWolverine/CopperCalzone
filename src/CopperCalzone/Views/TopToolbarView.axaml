<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CopperCalzone.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="64"
             x:Class="CopperCalzone.Views.TopToolbarView"
             x:DataType="vm:MainViewModel"
             x:Name="Root">

  <Border x:Name="RootBorder"
          Background="{DynamicResource M3SurfaceBrush}"
          Padding="12,6">
    <Grid>
      <!-- DESKTOP TOOLBAR (Width >= 760) -->
      <Grid x:Name="DesktopGrid"
            IsVisible="{Binding !IsCompact, ElementName=Root}"
            MinHeight="56"
            ColumnDefinitions="Auto,*,Auto">

        <!-- Left: M3 Navigation Drawer Toggle + Expressive Board Title -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Command="{Binding ToggleLeftSidebarCommand}"
                  ToolTip.Tip="Toggle Nets &amp; Layers Side Sheet"
                  Classes="m3-tonal"
                  Width="42" Height="42"
                  Padding="0"
                  CornerRadius="21"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <materialIcons:MaterialIcon Kind="Menu" Width="20" Height="20" />
          </Button>

          <StackPanel VerticalAlignment="Center" Spacing="1" MaxWidth="280">
            <TextBlock Classes="m3-title-medium"
                       Text="{Binding BoardTitle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="m3-caption"
                       Text="{Binding BoardSubtitle}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

        <!-- Center: M3 Expressive Floating Pill Toolbar & Segmented Switcher -->
        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center"
                      Margin="8,2">

            <!-- M3 Segmented Pill Switcher: Viewer / GitHub / Settings -->
            <Border Classes="m3-pill-bar">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Button Classes="tool-btn"
                        Classes.active="{Binding IsViewerTabActive}"
                        Command="{Binding SwitchToViewerCommand}"
                        ToolTip.Tip="Switch to PCB Viewer">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="DeveloperBoard" Width="16" Height="16" />
                    <TextBlock Text="Viewer" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="tool-btn"
                        Classes.active="{Binding IsGitHubTabActive}"
                        Command="{Binding OpenGitHubBrowserCommand}"
                        ToolTip.Tip="Switch to GitHub PCB Browser">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Github" Width="16" Height="16" />
                    <TextBlock Text="GitHub" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="tool-btn"
                        Classes.active="{Binding IsSettingsTabActive}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Preferences &amp; Settings">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <!-- M3 Expressive Floating Viewport Pill Toolbar -->
            <Border Classes="m3-pill-bar"
                    BoxShadow="0 2 8 0 #26000000">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="tool-btn"
                        Command="{Binding ZoomInCommand}"
                        ToolTip.Tip="Zoom In (+)">
                  <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="18" Height="18" />
                </Button>
                <Button Classes="tool-btn"
                        Command="{Binding ZoomOutCommand}"
                        ToolTip.Tip="Zoom Out (-)">
                  <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="18" Height="18" />
                </Button>
                <Button Classes="tool-btn"
                        Command="{Binding ZoomFitCommand}"
                        ToolTip.Tip="Fit Board to View (Home)">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="FitToScreenOutline" Width="16" Height="16" />
                    <TextBlock Text="Fit" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="tool-btn"
                        Command="{Binding RotateCounterClockwiseCommand}"
                        ToolTip.Tip="Rotate 90° CCW (Shift+R)">
                  <materialIcons:MaterialIcon Kind="RotateLeft" Width="18" Height="18" />
                </Button>
                <Button Classes="tool-btn"
                        Command="{Binding RotateClockwiseCommand}"
                        ToolTip.Tip="Rotate 90° CW (R)">
                  <materialIcons:MaterialIcon Kind="RotateRight" Width="18" Height="18" />
                </Button>
                <Button Classes="tool-btn"
                        Classes.active="{Binding IsFlipped}"
                        Command="{Binding ToggleFlipBoardCommand}"
                        ToolTip.Tip="Flip Board View / Mirror X (F)">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="FlipHorizontal" Width="16" Height="16" />
                    <TextBlock Text="Flip" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="tool-btn"
                        Classes.active="{Binding ShowPadNetNames}"
                        Command="{Binding TogglePadLabelsCommand}"
                        ToolTip.Tip="Toggle Net Names on Pads (N)">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="TagTextOutline" Width="16" Height="16" />
                    <TextBlock Text="Labels" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="tool-btn"
                        Classes.active="{Binding IsImmersiveMode}"
                        Command="{Binding ToggleImmersiveModeCommand}"
                        ToolTip.Tip="Toggle Immersive / Fullscreen Mode (Hide System Bars)">
                  <materialIcons:MaterialIcon Kind="Fullscreen" Width="18" Height="18" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Right: M3 Extended FAB Open Button & Theme Toggle -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- Open File Extended FAB -->
          <Button Command="{Binding RequestOpenFileCommand}"
                  Classes="m3-extended-fab"
                  ToolTip.Tip="Open .kicad_pcb, .json, or CopperCalzone .html file (Ctrl+O)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18" />
              <TextBlock Text="Open PCB" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Theme Toggle Tonal Circle Button -->
          <Button Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="Toggle Dark / Light Material 3 Theme"
                  Classes="m3-tonal"
                  Width="42" Height="42"
                  Padding="0"
                  CornerRadius="21"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- COMPACT / MOBILE TOOLBAR (Width < 760, Portrait Phones & Narrow Windows) -->
      <Grid x:Name="CompactGrid"
            IsVisible="{Binding IsCompact, ElementName=Root}"
            RowDefinitions="Auto,Auto"
            Margin="0,2,0,4">

        <!-- Row 0: Navigation, Board Title, Open FAB, GitHub, Settings & Theme Toggle -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,2,0,6">
          <!-- Sidebar Toggle Button -->
          <Button Grid.Column="0"
                  Command="{Binding ToggleLeftSidebarCommand}"
                  ToolTip.Tip="Toggle Nets &amp; Layers Drawer"
                  Classes="m3-tonal"
                  Width="40" Height="40"
                  Padding="0"
                  CornerRadius="20"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Margin="0,0,8,0">
            <materialIcons:MaterialIcon Kind="Menu" Width="18" Height="18" />
          </Button>

          <!-- Board Title & Subtitle -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,6,0">
            <TextBlock Classes="m3-title-small"
                       Text="{Binding BoardTitle}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="m3-caption"
                       FontSize="10.5"
                       Text="{Binding BoardSubtitle}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <!-- Open PCB Extended FAB (Compact) -->
          <Button Grid.Column="2"
                  Command="{Binding RequestOpenFileCommand}"
                  Classes="m3-extended-fab"
                  ToolTip.Tip="Open .kicad_pcb, .json, or CopperCalzone .html file"
                  Padding="12,8"
                  CornerRadius="14"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
              <TextBlock Text="Open" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- GitHub Tab Toggle Button (Compact) -->
          <Button Grid.Column="3"
                  Command="{Binding OpenGitHubBrowserCommand}"
                  ToolTip.Tip="Switch to GitHub PCB Browser"
                  Classes="tool-btn"
                  Classes.active="{Binding IsGitHubTabActive}"
                  Padding="10,8"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Github" Width="18" Height="18" />
          </Button>

          <!-- Settings Tab Toggle Button (Compact) -->
          <Button Grid.Column="4"
                  Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="Preferences &amp; Settings"
                  Classes="tool-btn"
                  Classes.active="{Binding IsSettingsTabActive}"
                  Padding="10,8"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18" />
          </Button>

          <!-- Theme Toggle Button -->
          <Button Grid.Column="5"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="Toggle Dark / Light Material 3 Theme"
                  Classes="m3-tonal"
                  Width="40" Height="40"
                  Padding="0"
                  CornerRadius="20"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18" />
          </Button>
        </Grid>

        <!-- Row 1: Floating Viewport Controls (Horizontally Scrollable) -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <!-- Viewport Tools Pill Group -->
            <Border Background="{DynamicResource M3SurfaceContainerHighBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="3">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="tool-btn"
                        Command="{Binding ZoomInCommand}"
                        Padding="9,6"
                        ToolTip.Tip="Zoom In (+)">
                  <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="16" Height="16" />
                </Button>
                <Button Classes="tool-btn"
                        Command="{Binding ZoomOutCommand}"
                        Padding="9,6"
                        ToolTip.Tip="Zoom Out (-)">
                  <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="16" Height="16" />
                </Button>
                <Button Classes="tool-btn"
                        Command="{Binding ZoomFitCommand}"
                        Padding="10,6"
                        ToolTip.Tip="Fit Board to View">
                  <TextBlock Text="Fit" />
                </Button>
                <Button Classes="tool-btn"
                        Command="{Binding RotateCounterClockwiseCommand}"
                        Padding="9,6"
                        ToolTip.Tip="Rotate 90° CCW">
                  <materialIcons:MaterialIcon Kind="RotateLeft" Width="16" Height="16" />
                </Button>
                <Button Classes="tool-btn"
                        Command="{Binding RotateClockwiseCommand}"
                        Padding="9,6"
                        ToolTip.Tip="Rotate 90° CW">
                  <materialIcons:MaterialIcon Kind="RotateRight" Width="16" Height="16" />
                </Button>
                <Button Classes="tool-btn"
                        Classes.active="{Binding IsFlipped}"
                        Command="{Binding ToggleFlipBoardCommand}"
                        Padding="10,6"
                        ToolTip.Tip="Flip Board View">
                  <TextBlock Text="Flip" />
                </Button>
                <Button Classes="tool-btn"
                        Classes.active="{Binding ShowPadNetNames}"
                        Command="{Binding TogglePadLabelsCommand}"
                        Padding="10,6"
                        ToolTip.Tip="Toggle Net Names on Pads">
                  <TextBlock Text="Labels" />
                </Button>
                <Button Classes="tool-btn"
                        Classes.active="{Binding IsImmersiveMode}"
                        Command="{Binding ToggleImmersiveModeCommand}"
                        Padding="10,6"
                        ToolTip.Tip="Toggle Immersive Mode (Hide System Bars)">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="Fullscreen" Width="16" Height="16" />
                    <TextBlock Text="Immersive" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</UserControl>
