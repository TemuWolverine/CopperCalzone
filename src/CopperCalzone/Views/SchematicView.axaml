<UserControl
          x:Class="CopperCalzone.Views.SchematicView"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:m="using:CopperCalzone.Markup"
          xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:render="using:CopperCalzone.Rendering.Schematic"
          xmlns:vm="using:CopperCalzone.ViewModels"
          d:DesignHeight="800"
          d:DesignWidth="1280"
          x:DataType="vm:SchematicViewModel"
          Background="{DynamicResource M3SurfaceBrush}"
          mc:Ignorable="d">

    <Grid>
        <!--  1. Schematic Hardware-Accelerated Skia Canvas  -->
        <render:SchCanvasControl x:Name="Canvas" IsVisible="{Binding HasSchematic}" />

        <!--  2. Empty State Overlay (When no schematic is loaded)  -->
        <Border
                  Padding="32,24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource M3SurfaceContainerLowBrush}"
                  BoxShadow="0 4 16 0 #33000000"
                  CornerRadius="16"
                  IsVisible="{Binding !HasSchematic}">
            <StackPanel
                      MaxWidth="360"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="12">
                <Border
                          Width="64"
                          Height="64"
                          HorizontalAlignment="Center"
                          Background="{DynamicResource M3SurfaceContainerHighBrush}"
                          CornerRadius="32">
                    <materialIcons:MaterialIcon
                              Width="32"
                              Height="32"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource M3OutlineBrush}"
                              Kind="FileDocumentOutline" />
                </Border>
                <TextBlock
                          Classes="m3-title-medium"
                          Text="{Binding SchematicTitle}"
                          TextAlignment="Center" />
                <TextBlock
                          Classes="m3-body-medium"
                          Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                          Text="{Binding SchematicSubtitle}"
                          TextAlignment="Center"
                          TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  3. Top-Left Floating Sheet Selector Card  -->
        <Border
                  Margin="16,14"
                  Padding="10,6"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  BoxShadow="0 4 14 0 #33000000"
                  Classes="m3-pill-bar"
                  IsVisible="{Binding HasSchematic}">
            <StackPanel
                      VerticalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="10">
                <materialIcons:MaterialIcon
                          Width="18"
                          Height="18"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource M3PrimaryBrush}"
                          Kind="LayersOutline" />
                <TextBlock
                          VerticalAlignment="Center"
                          Classes="m3-label-medium"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource M3OnSurfaceBrush}"
                          Text="Sheet:" />

                <ComboBox
                          Height="32"
                          MinWidth="220"
                          MaxWidth="360"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Sheets}"
                          SelectedItem="{Binding SelectedSheet}"
                          ToolTip.Tip="Select Schematic Sheet">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SchematicSheetItem">
                            <TextBlock
                                      VerticalAlignment="Center"
                                      Text="{Binding Name}"
                                      TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <!--  4. Top-Right Floating Viewport Zoom Controls  -->
        <Border
                  Margin="16,14"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  BoxShadow="0 4 14 0 #33000000"
                  Classes="m3-pill-bar"
                  IsVisible="{Binding HasSchematic}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                          Classes="tool-btn"
                          Command="{Binding ZoomInCommand}"
                          ToolTip.Tip="{m:PlatformTip 'Zoom In',
                                                      '(+)'}">
                    <materialIcons:MaterialIcon
                              Width="18"
                              Height="18"
                              Kind="MagnifyPlusOutline" />
                </Button>
                <Button
                          Classes="tool-btn"
                          Command="{Binding ZoomOutCommand}"
                          ToolTip.Tip="{m:PlatformTip 'Zoom Out',
                                                      '(-)'}">
                    <materialIcons:MaterialIcon
                              Width="18"
                              Height="18"
                              Kind="MagnifyMinusOutline" />
                </Button>
                <Button
                          Classes="tool-btn"
                          Command="{Binding ZoomFitCommand}"
                          ToolTip.Tip="{m:PlatformTip 'Fit to Screen',
                                                      '(Home)'}">
                    <materialIcons:MaterialIcon
                              Width="18"
                              Height="18"
                              Kind="FitToScreenOutline" />
                </Button>
            </StackPanel>
        </Border>

        <!--  5. Bottom-Right HUD Status Pill  -->
        <Border
                  Margin="16,16"
                  Padding="12,6"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Background="{DynamicResource M3SurfaceContainerHighBrush}"
                  BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                  BorderThickness="1"
                  BoxShadow="0 2 8 0 #22000000"
                  CornerRadius="16"
                  IsVisible="{Binding HasSchematic}">
            <StackPanel
                      VerticalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="8">
                <TextBlock
                          VerticalAlignment="Center"
                          Classes="m3-mono m3-label-small"
                          Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                          Text="{Binding HudCoordinates}" />
                <TextBlock
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource M3OutlineBrush}"
                          Text="•" />
                <TextBlock
                          VerticalAlignment="Center"
                          Classes="m3-mono m3-label-small"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource M3PrimaryBrush}"
                          Text="{Binding HudZoom}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>

