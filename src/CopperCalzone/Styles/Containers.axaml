<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- M3 Expressive Card Container (Used in Sidebar, Sheets) -->
  <Style Selector="Border.m3-card">
    <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!-- M3 Elevated Floating Overlay Card (Pin Inspector, HUD, Hero) -->
  <Style Selector="Border.m3-elevated-card">
    <Setter Property="Background" Value="{DynamicResource M3SurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BoxShadow" Value="0 10 28 0 #55000000" />
  </Style>

  <!-- M3 Surface Sheet Outer Border (Sidebar, GitHub Browser, Viewport) -->
  <Style Selector="Border.m3-surface-sheet">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- M3 Expressive Pill Search Bar -->
  <Style Selector="Border.m3-search-bar">
    <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="14,4" />
  </Style>

  <!-- M3 Expressive Segmented Pill Bar Container -->
  <Style Selector="Border.m3-pill-bar">
    <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource M3OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <!-- M3 Badges & Chips Containers -->
  <Style Selector="Border.m3-badge-secondary">
    <Setter Property="Background" Value="{DynamicResource M3SecondaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <Style Selector="Border.m3-badge-tertiary">
    <Setter Property="Background" Value="{DynamicResource M3TertiaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <Style Selector="Border.m3-badge-primary">
    <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <!-- M3 Splitter / Column Resizer Thumb Styles -->
  <Style Selector="Thumb.col-resizer">
    <Setter Property="Width" Value="8" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Width="8" HorizontalAlignment="Right">
          <Border Width="1.5"
                  Height="14"
                  CornerRadius="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource M3OutlineVariantBrush}"
                  Opacity="0.3"
                  Classes="col-resizer-line" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Thumb.col-resizer:pointerover /template/ Border.col-resizer-line">
    <Setter Property="Opacity" Value="1.0" />
    <Setter Property="Width" Value="2" />
    <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
  </Style>
  <Style Selector="Thumb.col-resizer:pressed /template/ Border.col-resizer-line">
    <Setter Property="Opacity" Value="1.0" />
    <Setter Property="Width" Value="2" />
    <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
  </Style>

  <Style Selector="Thumb.sidebar-resizer">
    <Setter Property="Width" Value="8" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Width="8" HorizontalAlignment="Center">
          <Border Width="2"
                  CornerRadius="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Margin="0,8,0,16"
                  Background="{DynamicResource M3OutlineVariantBrush}"
                  Opacity="0.25"
                  Classes="sidebar-resizer-line" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Thumb.sidebar-resizer:pointerover /template/ Border.sidebar-resizer-line">
    <Setter Property="Opacity" Value="1.0" />
    <Setter Property="Width" Value="3" />
    <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
  </Style>
  <Style Selector="Thumb.sidebar-resizer:pressed /template/ Border.sidebar-resizer-line">
    <Setter Property="Opacity" Value="1.0" />
    <Setter Property="Width" Value="3" />
    <Setter Property="Background" Value="{DynamicResource M3PrimaryBrush}" />
  </Style>

</Styles>
